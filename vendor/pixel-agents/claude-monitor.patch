+  '..oSssssssssso..',
+  '.oSsssssssssso..',
+  '.oSssssssssssso.',
+  '.oSssssssssssso.',
+  '.oSssssssssssso.',
+  '.oSsssssssssssso',
+  '.oSsssssssssssso',
+  '.oSsssssssssssso',
+  '.oSssssssssssso.',
