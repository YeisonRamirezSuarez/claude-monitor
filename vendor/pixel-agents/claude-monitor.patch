+// Local patch (claude-monitor): how agents behave in the office beyond the
+// stock "sit and type / wander" loop.
+//
+// - Thinking (active, no tool running for a few seconds, right after working):
+//   walk to a bookshelf and stand there reading.
+// - Resting (turn over, or nothing happening for a while): sit on the sofa, or
+//   half the time go do something — the fridge, the piano, the water cooler,
+//   the stove — and after a while move on to something else. The TV of the
+//   room turns on while someone rests there, and the meeting room's screen
+//   while a meeting runs.
+// - Waiting on a sub-agent (a foreground Agent/Task call is pending): sit on a
+//   free sofa or bench until the result comes back.
+// - Talking: when two agents of the same session message each other (or a
+//   sub-agent reports in), both go sit together at the meeting table (wooden
+//   chairs) and talk; with no meeting room, the speaker walks up to the other.
+// - Arriving / leaving: new sessions and sub-agents walk in through the door
+//   (sub-agents first go greet their lead); closed ones walk out through it.
+// - Per-account filter: the embedding claude-monitor window says which agents
+//   to show.
+// - Real state: claude-monitor also says what each agent is actually doing
+//   (read from the transcripts and the live-session registry). Transcript-only
+//   sessions often miss tool-done / turn-end events here, so that state wins
+//   over the one guessed from events: "te espera" rests, "trabajando" stays at
+//   the desk, "pensando" goes to think.
+// - Teams: a sub-agent takes the free desk closest to its lead, so each
+//   session's team works together inside the one shared office.
+// - Roles: leads (main agents) sit in the "Despacho" area, sub-agents work in
+//   "Trabajo" (layout areas of the "edificio"; other layouts are left alone).
+// - Meetings: a sub-agent that is launched first meets its lead in the meeting
+//   room (briefing), and before it leaves it meets it again (hand-off report).
+// - Stress: when claude-monitor says "estresado" (tools failing in a row, or an
+//   API error), it goes to the "Baños" area and stands there with its hands on
+//   its head under a storm bubble until it gets back on track.
+// - Emotions: talking, each one shows a feeling now and then in its bubble
+//   (heart, idea, !, ?, laugh), with a little hop.
+//
+// Every errand works by temporarily swapping the character's seat for the
+// errand's spot (a sofa seat, or a virtual seat in front of a shelf / next to
+// the other agent / at the door) and letting the stock FSM walk it there. When
+// the errand ends the real seat comes back and the FSM walks it home.
+
+import { getCatalogEntry } from '../layout/furnitureCatalog.js';
+import { findPath, isWalkable } from '../layout/tileMap.js';
+import type { Character, Emote, Seat } from '../types.js';
+import { Direction } from '../types.js';
+import { startMatrixEffect } from './matrixEffectState.js';
+import type { OfficeState } from './officeState.js';
+
+/** Seconds with no tool running before an active agent goes to think. Short
+ *  gaps between two tools are normal and should not send it walking. */
+const THINK_AFTER_SEC = 4;
+/** Past this with nothing running it is not thinking any more, just idle —
+ *  transcript-only sessions can stay "active" long after the turn ended. */
+const IDLE_AFTER_SEC = 45;
+/** How long a conversation lasts once they are together. */
+const TALK_SEC = 6;
+/** Longest walk to the meeting room before the talk starts anyway. */
+const TALK_WALK_MAX_SEC = 20;
+/** How long the hello bubble shows when a session walks in. */
+const GREET_SEC = 3;
+/** Give up walking out after this long and just fade out. */
+const LEAVE_TIMEOUT_SEC = 25;
+/** How far (in tiles) a sub-agent's desk may be from its lead's. Further
+ *  than this it works standing next to the lead instead. */
+const TEAM_SEAT_MAX_DIST = 8;
+/** Right after the webview loads, the agents it restores were already there:
+ *  they appear in place instead of walking in. */
+const WARMUP_SEC = 5;
+
+const SUBAGENT_TOOLS = new Set(['Agent', 'Task']);
+/** Resting / waiting seats. Not benches: desks use CUSHIONED_BENCH as seats. */
+const LOUNGE = /SOFA|ARMCHAIR/i;
+/** Meeting-room chairs: the wooden ones around the meeting tables. */
+const MEETING = /WOODEN_CHAIR|KN_CHAIR/i;
+/** Layout area (see the "edificio" layout) where leads direct their team. */
+const DESPACHO = 'Despacho';
+const TRABAJO = 'Trabajo';
+const BIBLIOTECA = 'Biblioteca';
+const BANOS = 'Baños';
+const EMOTES: Emote[] = ['heart', 'idea', 'exclaim', 'question', 'laugh'];
+/** claude-monitor reports every ~1.5 s; older than this, its word no longer counts. */
+const EXTERNAL_FRESH_SEC = 8;
+/** How often an agent checks it sits in its role's area. */
+const ROLE_CHECK_SEC = 2;
+const SHELF = /BOOKSHELF/i;
+const VIRTUAL = 'cm:';
+/** Things to do on a break, standing at them with busy hands: the fridge, the
+ *  piano, the water cooler, the stove, the coffee… */
+const BREAK_SPOT = /KN_FRIDGE|KN_PIANO|KN_WATER_COOLER|KN_STOVE|KN_COUNTER_KETTLE|KN_COFFEE_MAKER|KN_MICROWAVE|KN_SINK$/;
+/** Chance a break starts at one of those instead of the sofa. */
+const BREAK_ACTIVITY_CHANCE = 0.5;
+/** A long break moves on to something else after this. */
+const BREAK_SWITCH_SEC = 30;
+/** Screens that light up: the meeting room's while a meeting runs, a TV while
+ *  someone in its room takes a break (or works, for the wall TVs). */
+const SCREEN = /^(KN_PROJ_SCREEN|KN_TV|KN_TV_STAND)$/;
+
+type Errand = 'think' | 'wait' | 'rest' | 'talk' | 'leave' | 'stress';
+
+interface Crew {
+  errand: Errand | null;
+  /** The real seat while on an errand. */
+  home: string | null;
+  errandSeat: string | null;
+  idleSec: number;
+  pending: Map<string, { name: string; background: boolean }>;
+  talkUntil: number;
+  talkWith: number | null;
+  greetUntil: number;
+  leftAt: number;
+  /** When both talkers reached their spots (null while still walking). */
+  talkSince: number | null;
+  /** Last time its role seat (Despacho / Trabajo) was checked. */
+  roleCheckAt: number;
+  /** A sub-agent that is done: it reports to its lead first, then leaves. */
+  leaveAfterTalk: boolean;
+  reported: boolean;
+  /** When the current errand started (a long break switches activity). */
+  errandSince: number;
+}
+
+/** Door tile of the current layout, for the renderer's doormat. */
+export let claudeMonitorDoor: { col: number; row: number } | null = null;
+/** Screens lit this frame, for the renderer (furniture uid -> its item). */
+export let claudeMonitorScreensOn: Array<{ type: string; col: number; row: number }> = [];
+
+export class ClaudeMonitorCrew {
+  private crew = new Map<number, Crew>();
+  private clock = 0;
+  private visible: Set<number> | null = null;
+  /** "leadId:toolUseId" -> the sub-agent's task, as claude-monitor reads it
+   *  from its sidecar. Sub-agents adopted mid-run have no Subtask label. */
+  private subLabels = new Map<string, string>();
+  /** What claude-monitor says each agent is doing, and when it said it. */
+  private external = new Map<number, { estado: string; at: number }>();
+  private doorFor: unknown = null;
+
+  private readonly os: OfficeState;
+
+  constructor(os: OfficeState) {
+    this.os = os;
+  }
+
+  private get(id: number): Crew {
+    let c = this.crew.get(id);
+    if (!c) {
+      c = {
+        errand: null,
+        home: null,
+        errandSeat: null,
+        idleSec: 0,
+        pending: new Map(),
+        talkUntil: 0,
+        talkWith: null,
+        greetUntil: 0,
+        leftAt: 0,
+        talkSince: null,
+        roleCheckAt: -Infinity,
+        leaveAfterTalk: false,
+        reported: false,
+        errandSince: 0,
+      };
+      this.crew.set(id, c);
+    }
+    return c;
+  }
+
+  // ── Inputs ──────────────────────────────────────────────────────────────
+
+  toolStart(id: number, toolId: string, name: string | null, background: boolean): void {
+    this.get(id).pending.set(toolId, { name: name ?? '', background });
+  }
+
+  toolDone(id: number, toolId: string): void {
+    this.crew.get(id)?.pending.delete(toolId);
+  }
+
+  toolsClear(id: number): void {
+    this.crew.get(id)?.pending.clear();
+  }
+
+  /** `from` and `to` meet and talk for a while: both at the meeting table
+   *  when there is one, otherwise `from` walks up to `to`. The talk time
+   *  counts from when they are together (capped, so a blocked path ends it). */
+  talk(from: number, to: number): void {
+    if (from === to || !this.os.characters.has(from) || !this.os.characters.has(to)) return;
+    const target = this.os.characters.get(to)!;
+    if (this.isLeaving(target)) return;
+    const until = this.clock + TALK_SEC + TALK_WALK_MAX_SEC;
+    const a = this.get(from);
+    a.talkUntil = until;
+    a.talkWith = to;
+    // What each one feels for this talk: a hand-off report ends happily; any
+    // other talk, whatever comes up.
+    const any = () => EMOTES[Math.floor(Math.random() * EMOTES.length)];
+    this.os.characters.get(from)!.cmEmote = a.leaveAfterTalk ? (Math.random() < 0.5 ? 'laugh' : 'heart') : any();
+    target.cmEmote = any();
+    if (this.hasMeetingRoom()) {
+      const b = this.get(to);
+      b.talkUntil = until;
+      b.talkWith = from;
+    }
+  }
+
+  private hasMeetingRoom(): boolean {
+    for (const uid of this.os.seats.keys()) if (MEETING.test(this.seatType(uid))) return true;
+    return false;
+  }
+
+  /** State as claude-monitor reads it: escribiendo, leyendo, delegando,
+   *  pensando, permiso, esperando, terminado. Stale after a few seconds. */
+  setExternalState(id: number, estado: string): void {
+    this.external.set(id, { estado, at: this.clock });
+  }
+
+  private externalState(id: number): string | null {
+    const e = this.external.get(id);
+    return e && this.clock - e.at < EXTERNAL_FRESH_SEC ? e.estado : null;
+  }
+
+  setSubagentLabel(leadId: number, toolUseId: string, label: string): void {
+    this.subLabels.set(`${leadId}:${toolUseId}`, label);
+  }
+
+  subagentLabel(leadId: number, toolUseId: string): string | undefined {
+    return this.subLabels.get(`${leadId}:${toolUseId}`);
+  }
+
+  /** Main agent ids to show (their sub-agents follow them); `null` shows all. */
+  setVisible(ids: number[] | null): void {
+    this.visible = ids ? new Set(ids) : null;
+  }
+
+  isVisible(ch: Character): boolean {
+    if (!this.visible) return true;
+    const main = ch.isSubagent && ch.parentAgentId !== null ? ch.parentAgentId : ch.id;
+    return this.visible.has(main);
+  }
+
+  /** The seat to persist (and to cluster the team around): the real one,
+   *  not an errand's. */
+  homeSeatOf(ch: Character): string | null {
+    const c = this.crew.get(ch.id);
+    return c?.errand ? c.home : ch.seatId;
+  }
+
+  /** The seat it returns to between errands. */
+  private realSeat(ch: Character, c: Crew): string | null {
+    return c.errand ? c.home : ch.seatId;
+  }
+
+  private setRealSeat(ch: Character, c: Crew, uid: string | null): void {
+    if (c.errand) c.home = uid;
+    else {
+      ch.seatId = uid;
+      if (uid) this.os.sendToSeat(ch.id);
+    }
+  }
+
+  private hasArea(label: string): boolean {
+    return this.os.layout.areas?.some((a) => a.label === label) ?? false;
+  }
+
+  private areaAt(col: number, row: number): string | null {
+    return this.os.layout.areaTiles?.[row * this.os.layout.cols + col] ?? null;
+  }
+
+  private seatArea(uid: string | null): string | null {
+    const seat = uid ? this.os.seats.get(uid) : undefined;
+    return seat ? this.areaAt(seat.seatCol, seat.seatRow) : null;
+  }
+
+  /** Leads belong in the Despacho, sub-agents in Trabajo: move to a free desk
+   *  there when the current one is elsewhere. Layouts without those areas are
+   *  left as they are. */
+  private placeByRole(ch: Character, c: Crew): void {
+    if (this.clock - c.roleCheckAt < ROLE_CHECK_SEC) return;
+    c.roleCheckAt = this.clock;
+    const area = ch.isSubagent ? TRABAJO : DESPACHO;
+    const current = this.realSeat(ch, c);
+    if (this.seatArea(current) === area) return;
+    const lead = ch.isSubagent && ch.parentAgentId !== null ? this.os.characters.get(ch.parentAgentId) : undefined;
+    const desk = this.freeSeatIn(area, lead ?? ch);
+    if (!desk) return;
+    const old = current ? this.os.seats.get(current) : undefined;
+    if (old && !current!.startsWith(VIRTUAL)) old.assigned = false;
+    desk.assigned = true;
+    this.setRealSeat(ch, c, desk.uid);
+  }
+
+  private freeSeatIn(area: string, ch: Character): Seat | null {
+    let best: Seat | null = null;
+    let bestD = Infinity;
+    for (const [uid, seat] of this.os.seats) {
+      if (seat.assigned || uid.startsWith(VIRTUAL) || this.areaAt(seat.seatCol, seat.seatRow) !== area) continue;
+      const type = this.seatType(uid);
+      if (LOUNGE.test(type) || MEETING.test(type)) continue;
+      const d = dist(ch, seat.seatCol, seat.seatRow);
+      if (d < bestD) {
+        best = seat;
+        bestD = d;
+      }
+    }
+    return best;
+  }
+
+  isLeaving(ch: Character): boolean {
+    return this.crew.get(ch.id)?.errand === 'leave';
+  }
+
+  isStressed(id: number): boolean {
+    return this.crew.get(id)?.errand === 'stress';
+  }
+
+  // ── Teams ───────────────────────────────────────────────────────────────
+
+  /** Give a new sub-agent the free desk closest to its lead (not a sofa, not
+   *  an errand spot). No desk close enough: it keeps working next to the lead. */
+  seatSubagent(ch: Character): void {
+    if (!ch.isSubagent || ch.parentAgentId === null || ch.seatId) return;
+    const lead = this.os.characters.get(ch.parentAgentId);
+    if (!lead) return;
+    const leadSeat = (this.homeSeatOf(lead) && this.os.seats.get(this.homeSeatOf(lead)!)) || null;
+    const col = leadSeat ? leadSeat.seatCol : lead.tileCol;
+    const row = leadSeat ? leadSeat.seatRow : lead.tileRow;
+    // In the edificio sub-agents work in Trabajo, closest to their lead;
+    // elsewhere, the closest free desk within reach.
+    let best: Seat | null = this.freeSeatIn(TRABAJO, lead);
+    let bestD = Infinity;
+    for (const [uid, seat] of best ? [] : this.os.seats) {
+      if (seat.assigned || uid.startsWith(VIRTUAL)) continue;
+      const type = this.seatType(uid);
+      if (LOUNGE.test(type) || MEETING.test(type)) continue;
+      const d = Math.abs(seat.seatCol - col) + Math.abs(seat.seatRow - row);
+      if (d < bestD && d <= TEAM_SEAT_MAX_DIST) {
+        best = seat;
+        bestD = d;
+      }
+    }
+    if (!best) return;
+    best.assigned = true;
+    ch.seatId = best.uid;
+    const c = this.crew.get(ch.id);
+    if (c?.errand) c.home = best.uid; // arriving: goes to greet first, then sits here
+    else this.os.sendToSeat(ch.id);
+  }
+
+  // ── Arrive / leave ──────────────────────────────────────────────────────
+
+  /** A session that just opened walks in from the door to its desk. */
+  arrive(id: number): void {
+    const ch = this.os.characters.get(id);
+    const door = this.door();
+    if (!ch || !door || this.clock < WARMUP_SEC) return;
+    this.placeAt(ch, door);
+    this.get(id).greetUntil = this.clock + GREET_SEC;
+    this.os.sendToSeat(id);
+  }
+
+  /** A sub-agent that was just launched walks in and first goes to its lead. */
+  arriveSubagent(id: number): void {
+    const ch = this.os.characters.get(id);
+    const door = this.door();
+    if (!ch || !door || this.clock < WARMUP_SEC || ch.parentAgentId === null) return;
+    this.placeAt(ch, door);
+    this.talk(id, ch.parentAgentId);
+  }
+
+  /** Walk out through the door, then fade. Returns false when there is no
+   *  door to walk to (the caller then despawns in place as before). */
+  leave(ch: Character): boolean {
+    const door = this.door();
+    if (!door) return false;
+    const c = this.get(ch.id);
+    const lead = ch.isSubagent && ch.parentAgentId !== null ? this.os.characters.get(ch.parentAgentId) : undefined;
+    if (lead && !c.reported && !this.isLeaving(lead) && this.hasMeetingRoom()) {
+      // Hand-off: meet the lead in Reuniones first, then leave (see tick).
+      c.reported = true;
+      c.leaveAfterTalk = true;
+      ch.cmHold = true;
+      this.talk(ch.id, lead.id);
+      return true;
+    }
+    this.endErrand(ch, c);
+    const seat = this.virtualSeat(`door:${ch.id}`, door.col, door.row, Direction.DOWN);
+    c.home = null;
+    c.errand = 'leave';
+    c.errandSeat = seat.uid;
+    c.leftAt = this.clock;
+    ch.seatId = seat.uid;
+    ch.cmHold = true;
+    ch.bubbleType = null;
+    ch.cmPose = undefined;
+    this.os.sendToSeat(ch.id);
+    return true;
+  }
+
+  forget(id: number): void {
+    const c = this.crew.get(id);
+    if (c?.errandSeat?.startsWith(VIRTUAL)) this.os.seats.delete(c.errandSeat);
+    this.crew.delete(id);
+  }
+
+  // ── Per frame ───────────────────────────────────────────────────────────
+
+  tick(dt: number): void {
+    this.clock += dt;
+    claudeMonitorDoor = this.door();
+    for (const ch of this.os.characters.values()) {
+      if (ch.matrixEffect) continue;
+      const c = this.get(ch.id);
+
+      // A layout edit rebuilds every seat and reassigns agents: whatever errand
+      // was running is gone, and the seat the agent has now is its real one.
+      if (c.errand && c.errandSeat && !this.os.seats.has(c.errandSeat)) {
+        c.errand = null;
+        c.errandSeat = null;
+        c.home = null;
+        ch.cmPose = undefined;
+        ch.cmHold = false;
+      }
+
+      if (c.errand === 'leave') {
+        const arrived = ch.path.length === 0 && this.atSeat(ch);
+        if (arrived || this.clock - c.leftAt > LEAVE_TIMEOUT_SEC) {
+          if (c.errandSeat) this.os.seats.delete(c.errandSeat);
+          c.errandSeat = null;
+          startMatrixEffect(ch, 'despawn');
+        }
+        continue;
+      }
+
+      if (!c.leaveAfterTalk) this.placeByRole(ch, c);
+
+      // A finished sub-agent reports to its lead, then walks out.
+      if (c.leaveAfterTalk && c.errand !== 'talk' && !(c.talkUntil > this.clock)) {
+        c.leaveAfterTalk = false;
+        this.leave(ch);
+        continue;
+      }
