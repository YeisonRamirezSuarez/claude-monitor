+// Local patch (claude-monitor): customizable characters ("Personalizar").
+//
+// A look dresses one of the six bundled bodies (char_0..5): the body and its
+// poses (walk, type, read) come from that sheet; the head is replaced by one
+// built here — skull, face, hairstyle, hat, glasses, beard — and the colors of
+// skin, hair and clothes are swapped. Everything is generated from small masks,
+// so it works for every direction and frame without drawing each one.
+//
+// Every sheet shares the same body: in each frame the collar sits on a fixed
+// row (COLLAR below), and the head ends right above it. The head is drawn on a
+// 16×26 canvas whose chin is row CHIN; rows below the chin (long hair, beard,
+// hood) overlap the body.
+//
+// Pure (no DOM): the webview and the tests use it alike.
+
+import type { SpriteData } from '../types.js';
+
+export type HairStyle = 'original' | 'corto' | 'largo' | 'mono' | 'coleta' | 'cresta' | 'afro' | 'calvo';
+export type Hat = 'ninguno' | 'gorra' | 'gorro' | 'sombrero' | 'copa';
+export type Glasses = 'ninguna' | 'redondas' | 'cuadradas' | 'sol';
+export type Beard = 'ninguna' | 'bigote' | 'corta' | 'completa';
+export type Outfit = 'original' | 'vestido' | 'buzo' | 'traje';
+export type Build = 'normal' | 'alto' | 'bajito' | 'grueso';
+
+export interface Look {
+  /** Which bundled body (0..5). */
+  base: number;
+  /** '#rrggbb'; missing = the body's own color. */
+  skin?: string;
+  hair?: string;
+  top?: string;
+  bottom?: string;
+  shoes?: string;
+  hatColor?: string;
+  hairStyle?: HairStyle;
+  hat?: Hat;
+  glasses?: Glasses;
+  beard?: Beard;
+  outfit?: Outfit;
+  build?: Build;
+}
+
+export const HAIR_STYLES: HairStyle[] = ['original', 'corto', 'largo', 'mono', 'coleta', 'cresta', 'afro', 'calvo'];
+export const HATS: Hat[] = ['ninguno', 'gorra', 'gorro', 'sombrero', 'copa'];
+export const GLASSES: Glasses[] = ['ninguna', 'redondas', 'cuadradas', 'sol'];
+export const BEARDS: Beard[] = ['ninguna', 'bigote', 'corta', 'completa'];
+export const OUTFITS: Outfit[] = ['original', 'vestido', 'buzo', 'traje'];
+export const BUILDS: Build[] = ['normal', 'alto', 'bajito', 'grueso'];
+
+/** Directions as the sheets store them: front, back, side (facing right). */
+export type View = 'down' | 'up' | 'right';
+
+/** Row of the collar per view and frame (walk 0-2, type 3-4, read 5-6), the
+ *  same in every sheet; the head ends on the row above. */
+const COLLAR: Record<View, number[]> = {
+  down: [17, 18, 17, 22, 22, 22, 22],
+  up: [17, 18, 17, 17, 17, 17, 17],
+  right: [19, 18, 19, 19, 19, 19, 20],
+};
+/** The reading nod: the head dips one row on the last frame. */
+const NOD: Record<View, number[]> = {
+  down: [0, 0, 0, 0, 0, 0, 1],
+  up: [0, 0, 0, 0, 0, 0, 1],
+  right: [0, 0, 0, 0, 0, 0, 0],
+};
+/** Sitting frames (the legs go forward: no skirt below the lap). */
+const SEATED = [false, false, false, true, true, true, true];
+
+const W = 16;
+const H = 26;
+const CHIN = 19;
+
+// ── Colors ──────────────────────────────────────────────────────────────────
+
+type Hsl = [number, number, number];
+
+function toHsl(hex: string): Hsl {
+  const r = parseInt(hex.slice(1, 3), 16) / 255;
+  const g = parseInt(hex.slice(3, 5), 16) / 255;
+  const b = parseInt(hex.slice(5, 7), 16) / 255;
+  const max = Math.max(r, g, b);
+  const min = Math.min(r, g, b);
+  const l = (max + min) / 2;
+  if (max === min) return [0, 0, l];
+  const d = max - min;
+  const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
+  const h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
+  return [h * 60, s, l];
+}
+
+function toHex([h, s, l]: Hsl): string {
+  const c = (1 - Math.abs(2 * l - 1)) * s;
+  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
+  const m = l - c / 2;
+  const [r, g, b] =
+    h < 60 ? [c, x, 0] : h < 120 ? [x, c, 0] : h < 180 ? [0, c, x] : h < 240 ? [0, x, c] : h < 300 ? [x, 0, c] : [c, 0, x];
+  const k = (v: number) =>
+    Math.round(Math.max(0, Math.min(1, v + m)) * 255)
+      .toString(16)
+      .padStart(2, '0');
+  return `#${k(r)}${k(g)}${k(b)}`;
+}
+
+/** The same color, lighter or darker by `dl` (lightness 0..1). */
+function shade(hex: string, dl: number): string {
+  const [h, s, l] = toHsl(hex);
+  return toHex([h, s, Math.max(0, Math.min(1, l + dl))]);
+}
+
+/** Sprite pixels are '#rrggbb' or '#rrggbbaa' ('' is transparent). */
+const rgb = (p: string) => p.slice(0, 7).toLowerCase();
+
+// ── What each color of a body is ────────────────────────────────────────────
+
+type Role = 'hair' | 'skin' | 'top' | 'bottom' | 'shoes';
+
+/** Which role each color of a sheet plays, from where it shows up in the
+ *  standing front frame. Near-black lines and eyes are never recolored. */
+export function colorRoles(front: SpriteData): Map<string, Role> {
+  const votes = new Map<string, Map<Role, number>>();
+  const vote = (x: number, y: number, role: Role) => {
+    const p = front[y]?.[x];
+    if (!p) return;
+    const c = rgb(p);
+    if (toHsl(c)[2] < 0.12) return;
+    const v = votes.get(c) ?? new Map<Role, number>();
+    v.set(role, (v.get(role) ?? 0) + 1);
+    votes.set(c, v);
+  };
+  for (let y = 0; y <= 11; y++) for (let x = 0; x < 16; x++) vote(x, y, 'hair');
+  for (let y = 14; y <= 17; y++) for (let x = 3; x <= 12; x++) vote(x, y, 'skin');
+  for (let y = 19; y <= 23; y++) for (let x = 4; x <= 11; x++) vote(x, y, 'top');
+  for (let y = 24; y <= 27; y++) for (let x = 4; x <= 11; x++) vote(x, y, 'bottom');
+  for (let y = 28; y <= 31; y++) for (let x = 3; x <= 12; x++) vote(x, y, 'shoes');
+  // Hands (skin) hang next to the hips.
+  for (let y = 21; y <= 24; y++) for (const x of [1, 2, 13, 14]) vote(x, y, 'skin');
+  const out = new Map<string, Role>();
+  for (const [c, v] of votes) out.set(c, [...v].sort((a, b) => b[1] - a[1])[0][0]);
+  return out;
+}
+
+/** The hair's dark lines: near-black colors of the hair that the body never
+ *  uses. They go with the old hair when the head is replaced. */
+function hairLines(front: SpriteData): Set<string> {
+  const body = new Set<string>();
+  for (let y = 18; y < front.length; y++) for (const p of front[y]) if (p) body.add(rgb(p));
+  const out = new Set<string>();
+  for (let y = 0; y <= 11; y++)
+    for (const p of front[y] ?? []) if (p && toHsl(rgb(p))[2] < 0.12 && !body.has(rgb(p))) out.add(rgb(p));
+  return out;
+}
+
+/** The body's own color for a role: its most common one. */
+function roleColor(front: SpriteData, roles: Map<string, Role>, role: Role): string | undefined {
+  const count = new Map<string, number>();
+  for (const row of front) for (const p of row) if (p && roles.get(rgb(p)) === role) count.set(rgb(p), (count.get(rgb(p)) ?? 0) + 1);
+  return [...count].sort((a, b) => b[1] - a[1])[0]?.[0];
+}
