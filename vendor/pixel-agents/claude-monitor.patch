--- /dev/null
+++ b/webview-ui/test/claudeMonitorEdificio.test.ts
@@ -0,0 +1,177 @@
+/**
+ * claude-monitor patch: the real "edificio" layout with the real furniture
+ * catalog (manifests from public/assets; sprites faked — seats, desks and
+ * footprints are all this needs). Checks each behavior ends in its room.
+ *
+ * Run with: npm test
+ */
+
+import assert from 'node:assert/strict';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { beforeAll, test } from 'vitest';
+
+import { OfficeState } from '../src/office/engine/officeState.js';
+import { buildDynamicCatalog } from '../src/office/layout/furnitureCatalog.js';
+import type { OfficeLayout } from '../src/office/types.js';
+
+const ASSETS = path.join(__dirname, '..', 'public', 'assets');
+
+type Asset = Record<string, unknown> & { id: string };
+
+function loadCatalog(): void {
+  const catalog: Asset[] = [];
+  const walk = (m: Record<string, unknown>, group: Record<string, unknown>) => {
+    if (m.type === 'asset') {
+      catalog.push({
+        ...m,
+        id: m.id as string,
+        label: m.id,
+        category: group.category,
+        isDesk: group.category === 'desks',
+        canPlaceOnWalls: group.canPlaceOnWalls,
+        canPlaceOnSurfaces: group.canPlaceOnSurfaces,
+        backgroundTiles: m.backgroundTiles ?? group.backgroundTiles,
+      } as Asset);
+    } else for (const x of (m.members as Record<string, unknown>[]) ?? []) walk(x, group);
+  };
+  for (const dir of fs.readdirSync(path.join(ASSETS, 'furniture'))) {
+    const manifest = JSON.parse(fs.readFileSync(path.join(ASSETS, 'furniture', dir, 'manifest.json'), 'utf8'));
+    walk(manifest, manifest);
+  }
+  const sprites = Object.fromEntries(catalog.map((a) => [a.id, [['#000']]]));
+  assert.ok(buildDynamicCatalog({ catalog, sprites } as never), 'catalog built');
+}
+
+function edificio(): OfficeLayout {
+  return JSON.parse(fs.readFileSync(path.join(ASSETS, 'default-layout-3.json'), 'utf8'));
+}
+
+const area = (os: OfficeState, col: number, row: number) =>
+  os.layout.areaTiles?.[row * os.layout.cols + col] ?? null;
+
+function run(os: OfficeState, seconds: number): void {
+  for (let t = 0; t < seconds; t += 0.05) os.update(0.05);
+}
+
+beforeAll(loadCatalog);
+
+function office() {
+  const os = new OfficeState(edificio());
+  run(os, 6);
+  os.addAgent(1, 0, 0);
+  const ch = os.characters.get(1)!;
+  ch.matrixEffect = null;
+  return { os, ch };
+}
+
+test('the building has desks, sofas, shelves and meeting chairs', () => {
+  const os = new OfficeState(edificio());
+  const areas = [...os.seats.values()].map((s) => area(os, s.seatCol, s.seatRow));
+  const count = (a: string) => areas.filter((x) => x === a).length;
+  assert.ok(count('Trabajo') >= 8, `desks in Trabajo: ${count('Trabajo')}`);
+  assert.ok(count('Despacho') >= 2, `desks in Despacho: ${count('Despacho')}`);
+  assert.ok(count('Descanso') >= 8, `sofa seats in Descanso: ${count('Descanso')}`);
+  assert.ok(count('Reuniones') >= 8, `meeting chairs: ${count('Reuniones')}`);
+});
+
+test('an agent with nothing to do rests on a sofa in Descanso', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, false);
+  run(os, 40);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Descanso', `at ${ch.tileCol},${ch.tileRow}`);
+  assert.equal(ch.cmPose, 'sit');
+});
+
+test('when claude-monitor says it waits for you, it rests even if the office thinks it is busy', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'stuck', 'Bash', false); // a tool-done that never arrived
+  run(os, 10);
+  assert.notEqual(area(os, ch.tileCol, ch.tileRow), 'Descanso', 'on its own it stays working');
+  for (let t = 0; t < 30; t += 0.05) {
+    if (Math.round(t * 20) % 30 === 0) os.cm.setExternalState(1, 'esperando');
+    os.update(0.05);
+  }
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Descanso', `at ${ch.tileCol},${ch.tileRow}`);
+});
+
+test('an agent thinking right after a tool reads in the Biblioteca', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  run(os, 30);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Biblioteca', `at ${ch.tileCol},${ch.tileRow}`);
+});
+
+test('leads sit in the Despacho and their sub-agents work in Trabajo', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Edit', false);
+  run(os, 25);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Despacho', `lead at ${ch.tileCol},${ch.tileRow}`);
+  assert.equal(area(os, sub.tileCol, sub.tileRow), 'Trabajo', `sub at ${sub.tileCol},${sub.tileRow}`);
+});
+
+test('a finished sub-agent reports to its lead in Reuniones, then walks out', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Edit', false);
+  run(os, 20);
+  os.removeSubagent(1, 'toolu_1');
+  run(os, 14);
+  assert.equal(area(os, sub.tileCol, sub.tileRow), 'Reuniones', `reporting at ${sub.tileCol},${sub.tileRow}`);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Reuniones', 'its lead is there too');
+  run(os, 40);
+  assert.equal(os.characters.has(subId), false, 'then it walked out the door');
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Despacho', 'and the lead went back to its desk');
+});
+
+test('a lead and its sub-agent talking meet in Reuniones', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Read', false);
+  run(os, 3);
+  os.cm.talk(subId, 1);
+  // Seats are assigned at random, so the walk varies: they must meet within
+  // the walk allowance (20 s), wherever each one started.
+  let met = false;
+  for (let t = 0; t < 22 && !met; t += 0.05) {
+    os.update(0.05);
+    met =
+      area(os, ch.tileCol, ch.tileRow) === 'Reuniones' &&
+      area(os, sub.tileCol, sub.tileRow) === 'Reuniones' &&
+      ch.bubbleType === 'talk';
+  }
+  assert.ok(met, `met in Reuniones (lead ${ch.tileCol},${ch.tileRow} · sub ${sub.tileCol},${sub.tileRow})`);
+});
+
+test('the catalog has the new KN_ furniture and the building uses the screens', () => {
+  const ids = new Set<string>();
+  const walk = (m: Record<string, unknown>) => {
+    if (m.type === 'asset') ids.add(m.id as string);
+    else for (const x of (m.members as Record<string, unknown>[]) ?? []) walk(x);
+  };
+  for (const dir of fs.readdirSync(path.join(ASSETS, 'furniture'))) {
+    walk(JSON.parse(fs.readFileSync(path.join(ASSETS, 'furniture', dir, 'manifest.json'), 'utf8')));
+  }
+  for (const id of [
+    'KN_CHAIR_GRAY_FRONT', 'KN_CHAIR_TALL_SIDE', 'KN_ARMCHAIR_GREEN', 'KN_CANDELABRA', 'KN_LAMP_GOLD',
+    'KN_PLANT_SMALL', 'KN_PAINTING_WIDE', 'KN_MAP', 'KN_PORTRAIT', 'KN_MIRROR', 'KN_SHELF', 'KN_DRAWERS',
+    'KN_TV', 'KN_PROJ_SCREEN', 'KN_PROJECTOR', 'KN_TV_STAND',
+  ]) assert.ok(ids.has(id), `catalog has ${id}`);
+  const types = new Set(edificio().furniture.map((f) => f.type));
+  for (const id of ['KN_TV', 'KN_PROJ_SCREEN', 'KN_PROJECTOR']) assert.ok(types.has(id), `building has ${id}`);
+});
diff --git a/webview-ui/test/editorErase.test.ts b/webview-ui/test/editorErase.test.ts
new file mode 100644
index 0000000..49ff17c
--- /dev/null
+++ b/webview-ui/test/editorErase.test.ts
@@ -0,0 +1,183 @@
+/**
+ * claude-monitor patch: the Erase tool removes furniture before voiding floor.
+ * furnitureAt() picks the topmost item on a tile; erasing repeatedly on one
+ * tile peels it layer by layer (surface item, desk, then nothing -> floor).
+ *
+ * Real furniture catalog (manifests from public/assets, sprites faked), tiny
+ * synthetic room so the test does not depend on the shipped layout.
+ *
+ * Run with: npm test
+ */
+
+import assert from 'node:assert/strict';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { beforeAll, test } from 'vitest';
+
+import {
+  furnitureAt,
+  placeFurniture,
+  removeFurniture,
+} from '../src/office/editor/editorActions.js';
+import { EditorState } from '../src/office/editor/editorState.js';
+import { OfficeState } from '../src/office/engine/officeState.js';
+import { buildDynamicCatalog } from '../src/office/layout/furnitureCatalog.js';
+import type { OfficeLayout } from '../src/office/types.js';
+import { TileType } from '../src/office/types.js';
+
+const ASSETS = path.join(__dirname, '..', 'public', 'assets');
+
+type Asset = Record<string, unknown> & { id: string };
+
+// Copied from claudeMonitorEdificio.test.ts (kept separate on purpose).
+function loadCatalog(): void {
+  const catalog: Asset[] = [];
+  const walk = (m: Record<string, unknown>, group: Record<string, unknown>) => {
+    if (m.type === 'asset') {
+      catalog.push({
+        ...m,
+        id: m.id as string,
+        label: m.id,
+        category: group.category,
+        isDesk: group.category === 'desks',
+        canPlaceOnWalls: group.canPlaceOnWalls,
+        canPlaceOnSurfaces: group.canPlaceOnSurfaces,
+        backgroundTiles: m.backgroundTiles ?? group.backgroundTiles,
+      } as Asset);
+    } else for (const x of (m.members as Record<string, unknown>[]) ?? []) walk(x, group);
+  };
+  for (const dir of fs.readdirSync(path.join(ASSETS, 'furniture'))) {
+    const manifest = JSON.parse(
+      fs.readFileSync(path.join(ASSETS, 'furniture', dir, 'manifest.json'), 'utf8'),
+    );
+    walk(manifest, manifest);
+  }
+  const sprites = Object.fromEntries(catalog.map((a) => [a.id, [['']]]));
+  assert.ok(buildDynamicCatalog({ catalog, sprites } as never), 'catalog built');
+}
+
+beforeAll(loadCatalog);
+
+const COLS = 10;
+const ROWS = 8;
+
+/** Rows 0-1 wall, the rest floor. */
+function room(): OfficeLayout {
+  const tiles = Array.from({ length: COLS * ROWS }, (_, i) =>
+    i < COLS * 2 ? TileType.WALL : TileType.FLOOR_1,
+  );
+  return { version: 1, cols: COLS, rows: ROWS, tiles, furniture: [] };
+}
+
+function add(layout: OfficeLayout, type: string, col: number, row: number): OfficeLayout {
+  const next = placeFurniture(layout, { uid: `${type}@${col},${row}`, type, col, row });
+  assert.notEqual(next, layout, `${type} placed at ${col},${row}`);
+  return next;
+}
+
+/** One Erase click on a tile: remove the topmost furniture, or report the floor is next. */
+function eraseClick(layout: OfficeLayout, col: number, row: number): OfficeLayout | null {
+  const f = furnitureAt(layout, col, row);
+  return f ? removeFurniture(layout, f.uid) : null;
+}
+
+test('1x1 item is found on its tile and only there', () => {
+  const l = add(room(), 'BIN', 1, 4);
+  assert.equal(furnitureAt(l, 1, 4)?.type, 'BIN');
+  assert.equal(furnitureAt(l, 2, 4), null);
+  assert.equal(furnitureAt(l, 1, 5), null);
+});
+
+test('multi-tile desk is hit from a non-anchor tile', () => {
+  const l = add(room(), 'DESK_FRONT', 3, 4); // 3x2: cols 3-5, rows 4-5
+  for (const [c, r] of [
+    [3, 4],
+    [5, 4],
+    [3, 5],
+    [5, 5],
+    [4, 5],
+  ]) {
+    assert.equal(furnitureAt(l, c, r)?.type, 'DESK_FRONT', `${c},${r}`);
+  }
+  assert.equal(furnitureAt(l, 6, 4), null);
+  assert.equal(furnitureAt(l, 5, 6), null);
+});
+
+test('surface item on a desk goes first, then the desk, then nothing', () => {
+  let l = add(room(), 'DESK_FRONT', 3, 4);
+  l = add(l, 'COFFEE', 5, 4); // canPlaceOnSurfaces, listed AFTER the desk
+  assert.equal(furnitureAt(l, 5, 4)?.type, 'COFFEE');
+  l = eraseClick(l, 5, 4)!;
+  assert.equal(furnitureAt(l, 5, 4)?.type, 'DESK_FRONT');
+  l = eraseClick(l, 5, 4)!;
+  assert.equal(l.furniture.length, 0);
+  assert.equal(eraseClick(l, 5, 4), null, 'nothing left: the next click voids the floor');
+});
+
+test('surface item wins even when it comes BEFORE the desk in the array', () => {
+  const both = add(add(room(), 'DESK_FRONT', 3, 4), 'COFFEE', 5, 4);
+  const swapped = { ...both, furniture: [...both.furniture].reverse() };
+  assert.equal(furnitureAt(swapped, 5, 4)?.type, 'COFFEE');
+});
+
+test('wall item is removed via its wall tile (and its upper row)', () => {
+  const l = add(room(), 'LARGE_PAINTING', 7, 0); // 2x2: cols 7-8, rows 0-1; row 1 is the wall tile
+  assert.equal(l.tiles[1 * COLS + 8], TileType.WALL);
+  assert.equal(furnitureAt(l, 8, 1)?.type, 'LARGE_PAINTING');
+  assert.equal(furnitureAt(l, 7, 0)?.type, 'LARGE_PAINTING');
+  assert.equal(eraseClick(l, 8, 1)!.furniture.length, 0);
+  assert.equal(furnitureAt(l, 6, 1), null);
+});
+
+test('foreground item beats the background row of another item', () => {
+  // PLANT is 1x2 with backgroundTiles 1: its top tile is background.
+  const plantFirst = add(add(room(), 'PLANT', 7, 5), 'BIN', 7, 5);
+  assert.equal(furnitureAt(plantFirst, 7, 5)?.type, 'BIN');
+  assert.equal(furnitureAt(plantFirst, 7, 6)?.type, 'PLANT');
+  const binFirst = add(add(room(), 'BIN', 7, 5), 'PLANT', 7, 5);
+  assert.equal(furnitureAt(binFirst, 7, 5)?.type, 'BIN');
+});
+
+test('empty tile and out-of-range tile return null; removing an unknown uid is a no-op', () => {
+  const l = add(room(), 'BIN', 1, 4);
+  assert.equal(furnitureAt(l, 0, 7), null);
+  assert.equal(furnitureAt(l, -1, 0), null);
+  assert.equal(furnitureAt(l, COLS, ROWS), null);
+  assert.equal(removeFurniture(l, 'nope'), l);
+});
+
+test('removing furniture through the layout drops the office furniture count', () => {
+  const l = add(add(room(), 'DESK_FRONT', 3, 4), 'BIN', 1, 4);
+  const os = new OfficeState(l);
+  assert.equal(os.furniture.length, 2);
+  os.rebuildFromLayout(eraseClick(l, 1, 4)!);
+  assert.equal(os.furniture.length, 1);
+});
+
+test('repeat guard: one action per tile per press, a new tile or a new press acts again', () => {
+  // Same flow as the hook: guard first, then furniture, then floor.
+  const idx = 4 * COLS + 5;
+  const es = new EditorState();
+  let l = add(add(room(), 'DESK_FRONT', 3, 4), 'COFFEE', 5, 4);
+  const press = (i: number): OfficeLayout | null => {
+    if (es.eraseRepeat(i)) return l; // skipped: layout untouched
+    return eraseClick(l, i % COLS, Math.floor(i / COLS));
+  };
+  // mousedown + jittery mousemoves on the same tile: only the first acts
+  l = press(idx)!;
+  assert.deepEqual(
+    l.furniture.map((f) => f.type),
+    ['DESK_FRONT'],
+  );
+  assert.equal(press(idx), l);
+  assert.equal(press(idx), l);
+  // drag to another tile acts there
+  assert.equal(es.eraseRepeat(idx + 1), false);
+  // mouseup resets: the next click on the same tile peels the next layer
+  es.eraseLastIdx = -1;
+  l = press(idx)!;
+  assert.equal(l.furniture.length, 0);
+  es.reset();
+  assert.equal(es.eraseLastIdx, -1);
+});
