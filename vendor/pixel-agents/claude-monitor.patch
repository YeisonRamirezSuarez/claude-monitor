+// Local patch (claude-monitor): "Personalizar" — dress a lead the way you want:
+// body, skin, hair (color and style), clothes (colors and style), hat,
+// glasses, beard and build, with a live preview in its three directions. It is
+// kept by claude-monitor for this session or for every session of the account.
+import { useEffect, useRef, useState } from 'react';
+
+import { saveLook } from '../claudeMonitorBridge.js';
+import { CM_LOOK_CLOTHES, CM_LOOK_HAIRS, CM_LOOK_PREVIEW_BG, CM_LOOK_SKINS } from '../constants.js';
+import type { OfficeState } from '../office/engine/officeState.js';
+import {
+  BEARDS,
+  BUILDS,
+  GLASSES,
+  HAIR_STYLES,
+  HATS,
+  type Look,
+  OUTFITS,
+} from '../office/sprites/looks.js';
+import { getLookSprites } from '../office/sprites/spriteData.js';
+import { Direction, type SpriteData } from '../office/types.js';
+import { Button } from './ui/Button.js';
+import { Modal } from './ui/Modal.js';
+
+const LABELS: Record<string, string> = {
+  original: 'Original',
+  corto: 'Corto',
+  largo: 'Largo',
+  mono: 'Moño',
+  coleta: 'Coleta',
+  cresta: 'Cresta',
+  afro: 'Afro',
+  calvo: 'Calvo',
+  ninguno: 'Ninguno',
+  ninguna: 'Ninguna',
+  gorra: 'Gorra',
+  gorro: 'Gorro',
+  sombrero: 'Sombrero',
+  copa: 'Copa',
+  redondas: 'Redondas',
+  cuadradas: 'Cuadradas',
+  sol: 'De sol',
+  bigote: 'Bigote',
+  corta: 'Corta',
+  completa: 'Completa',
+  vestido: 'Vestido',
+  buzo: 'Buzo con capucha',
+  traje: 'Traje',
+  normal: 'Normal',
+  alto: 'Alto',
+  bajito: 'Bajito',
+  grueso: 'Grueso',
+};
+
+function Choices<T extends string>(p: { value: T; options: readonly T[]; onChange: (v: T) => void }) {
+  return (
+    <div className="flex flex-wrap gap-2">
+      {p.options.map((o) => (
+        <Button key={o} size="sm" variant={o === p.value ? 'active' : 'default'} onClick={() => p.onChange(o)}>
+          {LABELS[o] ?? o}
+        </Button>
+      ))}
+    </div>
+  );
+}
+
+/** Swatches plus the system color picker for any other color. `undefined` = the body's own. */
+function Colors(p: { value: string | undefined; swatches: string[]; onChange: (v: string | undefined) => void }) {
+  return (
+    <div className="flex flex-wrap gap-2 items-center">
+      <Button size="sm" variant={p.value === undefined ? 'active' : 'default'} onClick={() => p.onChange(undefined)}>
+        Original
+      </Button>
+      {p.swatches.map((c) => (
+        <button
+          key={c}
+          title={c}
+          aria-label={c}
+          onClick={() => p.onChange(c)}
+          className={`w-16 h-16 border-2 cursor-pointer ${p.value === c ? 'border-accent-bright' : 'border-border'}`}
+          style={{ background: c }}
+        />
+      ))}
+      <input
+        type="color"
+        aria-label="Otro color"
+        value={p.value ?? p.swatches[0]}
+        onChange={(e) => p.onChange(e.target.value)}
+        className="w-16 h-16 cursor-pointer"
+      />
+    </div>
+  );
+}
+
+function Row(p: { label: string; children: React.ReactNode }) {
+  return (
+    <div className="flex flex-col gap-1">
+      <span className="text-sm text-text-muted">{p.label}</span>
+      {p.children}
+    </div>
+  );
+}
+
+/** The three directions walking, redrawn on a small canvas. */
+function Preview({ look }: { look: Look }) {
+  const ref = useRef<HTMLCanvasElement>(null);
+  useEffect(() => {
+    const zoom = 4;
+    let raf = 0;
+    const draw = () => {
+      const c = ref.current?.getContext('2d');
+      const sprites = getLookSprites(look);
+      if (c && sprites) {
+        const f = Math.floor(performance.now() / 180) % 4;
+        c.fillStyle = CM_LOOK_PREVIEW_BG;
+        c.fillRect(0, 0, c.canvas.width, c.canvas.height);
+        [Direction.DOWN, Direction.RIGHT, Direction.UP].forEach((dir, i) => {
+          const s: SpriteData = sprites.walk[dir][f];
+          const ox = 8 + i * 24 + Math.floor((20 - s[0].length) / 2);
+          const oy = 38 - s.length;
+          s.forEach((row, y) =>
+            row.forEach((px, x) => {
+              if (!px) return;
+              c.fillStyle = px;
+              c.fillRect((ox + x) * zoom, (oy + y) * zoom, zoom, zoom);
+            }),
+          );
+        });
+      }
+      raf = requestAnimationFrame(draw);
+    };
+    draw();
+    return () => cancelAnimationFrame(raf);
+  }, [look]);
+  return <canvas ref={ref} width={88 * 4} height={40 * 4} className="border-2 border-border" style={{ imageRendering: 'pixelated' }} />;
+}
+
+export function CustomizerModal(p: { officeState: OfficeState }) {
+  const [agentId, setAgentId] = useState<number | null>(null);
+  const [look, setLook] = useState<Look>({ base: 0 });
+
+  useEffect(() => {
+    const open = (e: Event) => {
+      const id = (e as CustomEvent<{ id: number }>).detail?.id;
+      const ch = typeof id === 'number' ? p.officeState.characters.get(id) : undefined;
+      if (!ch || ch.isSubagent) return;
+      setLook(ch.cmLook ?? { base: ch.palette % 6 });
+      setAgentId(id);
+    };
+    window.addEventListener('claude-monitor-customize', open);
+    return () => window.removeEventListener('claude-monitor-customize', open);
+  }, [p.officeState]);
+
+  if (agentId === null) return null;
+  const set = <K extends keyof Look>(k: K, v: Look[K]) => setLook((l) => ({ ...l, [k]: v }));
+  const close = () => setAgentId(null);
+  const save = (scope: 'sesion' | 'cuenta', value: Look | null) => {
+    const ch = p.officeState.characters.get(agentId);
+    if (ch) ch.cmLook = value ?? undefined; // right away; claude-monitor confirms with its looks
+    saveLook(agentId, value, scope);
+    close();
+  };
+
+  return (
+    <Modal isOpen onClose={close} title="Personalizar" className="max-h-[90vh] overflow-y-auto w-[560px]">
+      <div className="flex flex-col gap-3 px-10 pb-6">
+        <Preview look={look} />
+        <Row label="Cuerpo">
+          <Choices
+            value={String(look.base)}
+            options={['0', '1', '2', '3', '4', '5']}
+            onChange={(v) => set('base', Number(v))}
+          />
+        </Row>
+        <Row label="Piel">
+          <Colors value={look.skin} swatches={CM_LOOK_SKINS} onChange={(v) => set('skin', v)} />
+        </Row>
+        <Row label="Peinado">
+          <Choices value={look.hairStyle ?? 'original'} options={HAIR_STYLES} onChange={(v) => set('hairStyle', v)} />
+        </Row>
+        <Row label="Color de pelo (y barba)">
+          <Colors value={look.hair} swatches={CM_LOOK_HAIRS} onChange={(v) => set('hair', v)} />
+        </Row>
+        <Row label="Ropa">
+          <Choices value={look.outfit ?? 'original'} options={OUTFITS} onChange={(v) => set('outfit', v)} />
+        </Row>
+        <Row label="Color de arriba">
+          <Colors value={look.top} swatches={CM_LOOK_CLOTHES} onChange={(v) => set('top', v)} />
+        </Row>
+        <Row label="Color de abajo">
+          <Colors value={look.bottom} swatches={CM_LOOK_CLOTHES} onChange={(v) => set('bottom', v)} />
+        </Row>
+        <Row label="Zapatos">
+          <Colors value={look.shoes} swatches={CM_LOOK_CLOTHES} onChange={(v) => set('shoes', v)} />
+        </Row>
+        <Row label="Sombrero">
+          <Choices value={look.hat ?? 'ninguno'} options={HATS} onChange={(v) => set('hat', v)} />
+        </Row>
+        {look.hat && look.hat !== 'ninguno' && (
+          <Row label="Color del sombrero">
+            <Colors value={look.hatColor} swatches={CM_LOOK_CLOTHES} onChange={(v) => set('hatColor', v)} />
+          </Row>
+        )}
+        <Row label="Gafas">
+          <Choices value={look.glasses ?? 'ninguna'} options={GLASSES} onChange={(v) => set('glasses', v)} />
+        </Row>
+        <Row label="Barba">
+          <Choices value={look.beard ?? 'ninguna'} options={BEARDS} onChange={(v) => set('beard', v)} />
+        </Row>
+        <Row label="Contextura">
+          <Choices value={look.build ?? 'normal'} options={BUILDS} onChange={(v) => set('build', v)} />
+        </Row>
+        <div className="flex flex-wrap gap-2 pt-2">
+          <Button size="md" variant="accent" onClick={() => save('sesion', look)}>
+            Guardar para esta sesión
+          </Button>
+          <Button size="md" onClick={() => save('cuenta', look)}>
+            Guardar para toda la cuenta
+          </Button>
+          <Button size="md" variant="ghost" onClick={() => save('sesion', null)}>
+            Quitar
+          </Button>
+        </div>
+        <span className="text-xs text-text-muted">
+          "Toda la cuenta": sus sesiones nuevas salen así; una sesión con su propia apariencia la mantiene.
+        </span>
+      </div>
+    </Modal>
+  );
+}
