+// Local patch (claude-monitor): more pets than the stock dog (claudio) and cat
+// (gitcat), drawn here pixel by pixel into the 96×96 sheet `decodePetPng`
+// reads (core/src/assets/pngDecoder.ts):
+//
+//   row 0 (y 0..31):  walkDown ×3, idleDown ×3   (16×32 each)
+//   row 1 (y 32..63): walkUp ×3,   idleUp ×3     (16×32 each)
+//   row 2 (y 64..95): walkRight ×3               (32×32 each; left is mirrored)
+//
+// Each animal is a front, a back and a side view (plus a second side pose for
+// the legs); the other frames come from those: walking dips one pixel, idle
+// blinks. petType is the index of the folder in sorted order, so the folders
+// are `km-*`: they sort after claudio and gitcat and saved layouts keep their pets.
+//
+//   node scripts/claude-monitor-pets.cjs
+const fs = require('fs');
+const path = require('path');
+const { PNG } = require('pngjs');
+
+const OUT = path.join(__dirname, '..', 'webview-ui', 'public', 'assets', 'pets');
+const rgb = (h) => [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
+
+/** A view: rows of chars ('.' transparent), all the same width. `k` is the eye (closed = outline). */
+function check(name, rows) {
+  const w = rows[0].length;
+  rows.forEach((r, i) => {
+    if (r.length !== w) throw new Error(`${name} row ${i} is ${r.length} wide, expected ${w}: ${r}`);
+  });
+  return rows;
+}
+/** Eyes closed: each `k` takes the color on its left (the skin around it). */
+const blink = (rows) => rows.map((r) => r.replace(/(.)k/g, '$1$1'));
+/** A step: one body row out, so the head dips a pixel while the feet stay put. */
+const bob = (rows) => rows.filter((_, i) => i !== Math.floor(rows.length * 0.6));
+
+/** Draws `rows` bottom-aligned in the cell (cx, cy, cw×32), centered horizontally. */
+function draw(img, rows, legend, cx, cy, cw) {
+  const x0 = cx + Math.floor((cw - rows[0].length) / 2);
+  const y0 = cy + 31 - (rows.length - 1);
+  rows.forEach((row, dy) =>
+    [...row].forEach((ch, dx) => {
+      if (ch === '.') return;
+      const color = legend[ch];
+      if (!color) throw new Error(`no color for '${ch}'`);
+      img.data.set([...rgb(color), 255], ((y0 + dy) * img.width + x0 + dx) * 4);
+    }),
+  );
+}
+
+function sheet({ front, back, side, side2, legend }) {
+  const img = new PNG({ width: 96, height: 96 });
+  const f = [front, bob(front), front, front, blink(front), front];
+  const b = [back, bob(back), back, back, back, back];
+  f.forEach((rows, i) => draw(img, rows, legend, i * 16, 0, 16));
+  b.forEach((rows, i) => draw(img, rows, legend, i * 16, 32, 16));
+  [side, side2, side].forEach((rows, i) => draw(img, rows, legend, i * 32, 64, 32));
+  return img;
+}
+
+const PETS = {
+  conejo: {
+    name: 'Conejo',
+    legend: { o: '5a4a42', w: 'efe9e2', s: 'cdc4ba', p: 'f2a7b5', n: 'e07a8a', k: '2a2020', t: 'ffffff' },
+    front: [
+      '....oo....oo....',
+      '...owpo..opwo...',
+      '...owpo..opwo...',
+      '...owpo..opwo...',
+      '...owwo..owwo...',
+      '..oowwwoowwwoo..',
+      '.owwwwwwwwwwwwo.',
+      '.owwkwwwwwwkwwo.',
+      '.owpwwwnnwwwpwo.',
+      '..owwwwwwwwwwo..',
+      '...oowwwwwwoo...',
+      '..owwwwwwwwwwo..',
+      '.oswwwwwwwwwwso.',
+      '.oswwwwwwwwwwso.',
+      '.osswwwwwwwwsso.',
+      '..owwwoooowwwo..',
+      '..ooooo..ooooo..',
+    ],
+    back: [
+      '....oo....oo....',
+      '...owwo..owwo...',
+      '...owwo..owwo...',
+      '...owwo..owwo...',
+      '...owwo..owwo...',
+      '..oowwwoowwwoo..',
+      '.owwwwwwwwwwwwo.',
+      '.owwwwwwwwwwwwo.',
+      '.owwwwwwwwwwwwo.',
+      '..owwwwwwwwwwo..',
+      '...oowwwwwwoo...',
+      '..owwwwwwwwwwo..',
+      '.oswwwwoowwwwso.',
+      '.oswwwottowwwso.',
+      '.osswwwoowwwsso.',
+      '..owwwoooowwwo..',
+      '..ooooo..ooooo..',
+    ],
+    side: [
+      '............oo......',
+      '...........owpo.....',
+      '...........owpo.....',
+      '..........owpo......',
+      '..........owwoo.....',
+      '.........owwwwwoo...',
+      '........owwwwwwwwo..',
+      '........owwwwwkwwwo.',
+      '........owwwwwwwwwno',
+      '..oooooowwwwwwwwwoo.',
+      '.owwwwwwwwwwwwwwwo..',
+      'otwwwwwwwwwwwwwwo...',
+      'otswwwwwwwwwwwwwo...',
+      '.osswwwwwwwwwwsso...',
+      '..owwwwoooooowwo....',
+      '.owwwwwo....owwo....',
+      '.ooooooo....oooo....',
+    ],
+    // Mid-hop: legs stretched out front and back.
+    side2: [
+      '............oo......',
+      '...........owpo.....',
+      '...........owpo.....',
+      '..........owpo......',
+      '..........owwoo.....',
+      '.........owwwwwoo...',
+      '........owwwwwwwwo..',
+      '........owwwwwkwwwo.',
+      '........owwwwwwwwwno',
+      '..oooooowwwwwwwwwoo.',
+      '.owwwwwwwwwwwwwwwo..',
