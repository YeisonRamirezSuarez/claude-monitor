+    skin: color('skin'),
+    hair: color('hair'),
+    top: color('top'),
+    bottom: color('bottom'),
+    shoes: color('shoes'),
+    hatColor: color('hatColor'),
+    hairStyle: pick('hairStyle', HAIR_STYLES),
+    hat: pick('hat', HATS),
+    glasses: pick('glasses', GLASSES),
+    beard: pick('beard', BEARDS),
+    outfit: pick('outfit', OUTFITS),
+    build: pick('build', BUILDS),
+  };
