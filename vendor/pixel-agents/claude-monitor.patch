+}
+put('KN_LAMP', 1, 3);
+put('KN_PLANT', 14, 2);
+put('KN_PLANT', 1, 9);
+put('KN_PLANT', 14, 9);
+
+// ── Trabajo: where the sub-agents work — two rows of four desks ──
+put('WHITEBOARD', 17, 0);
+put('KN_TV', 19, 0);
+put('LARGE_PAINTING', 22, 0);
+put('CLOCK', 26, 0);
+put('SMALL_PAINTING', 28, 0);
+for (const row of [3, 7]) {
+  for (const col of [16, 19, 22, 25]) {
+    put('DESK_FRONT', col, row);
+    put('PC_FRONT_OFF', col + 1, row);
+    put('CUSHIONED_BENCH', col + 1, row + 2);
+  }
+}
+put('PLANT', 29, 3);
+put('PLANT', 29, 7);
+
+// ── Biblioteca: a wall of shelves to stand and read at ──
+for (const col of [1, 3, 5, 7]) put('DOUBLE_BOOKSHELF', col, 12);
+put('BOOKSHELF', 9, 12);
+put('KN_DRAWERS', 10, 12);
+put('KN_SHELF', 2, 17);
+put('KN_DRAWERS', 8, 17);
+put('KN_LAMP', 1, 15);
+put('KN_LAMP', 10, 15);
+put('KN_PLANT', 5, 17);
+
+// ── Descanso: kitchen along the top, sofas, a piano ──
+put('KN_FRIDGE', 1, 19);
+put('KN_STOVE', 2, 19);
+put('KN_COUNTER_KETTLE', 4, 19);
+put('KN_SINK', 5, 19);
+put('KN_COUNTER_JARS', 6, 19);
+put('KN_WATER_COOLER', 1, 24);
+put('KN_TV_STAND', 7, 19);
+put('SOFA_FRONT', 3, 21);
+put('SOFA_SIDE', 2, 22);
+put('COFFEE_TABLE', 3, 22);
+put('COFFEE', 3, 23);
+put('SOFA_SIDE:left', 5, 22);
+put('SOFA_BACK', 3, 24);
+put('KN_TABLE_ROUND', 8, 22);
+put('KN_SOFA_ARMCHAIR', 8, 21);
+put('KN_SOFA_ARMCHAIR', 8, 23);
+put('KN_ARMCHAIR_GREEN', 6, 24);
+put('KN_ARMCHAIR_GREEN', 7, 24);
+put('KN_PIANO', 9, 19);
+put('KN_PLANT', 10, 25);
+
+// ── Reuniones: two long meeting tables with chairs all around ──
+for (const row of [15, 21]) {
+  put('KN_TABLE_LONG', 23, row);
+  for (const col of [23, 24, 25]) {
+    put('KN_CHAIR_FRONT', col, row - 1); // above the table, facing it
+    put('KN_CHAIR_BACK', col, row + 1); // below, facing it
+  }
+  const end = row === 15 ? 'KN_CHAIR_TALL' : 'KN_CHAIR_GRAY';
+  put(end + '_SIDE', 22, row);
+  put(end + '_SIDE:left', 26, row);
+  put('KN_PROJECTOR', 24, row);
+  put('KN_CANDELABRA', 25, row);
+}
+put('KN_PROJ_SCREEN', 21, 12); // in the corner: over the table it walled in the middle chair
+put('KN_PLANT_SMALL', 23, 21);
+put('KN_LAMP_GOLD', 29, 15);
+put('LARGE_PLANT', 28, 12);
+put('KN_PLANT', 20, 12);
+put('KN_PLANT', 20, 25);
+put('KN_LAMP', 29, 22);
+
+// ── Baños: sinks under mirrors, two toilets split by a stall, shower and tub ──
+put('KN_MIRROR', 31, 0);
+put('KN_MIRROR', 32, 0);
+put('KN_BATH_SINK', 31, 2);
+put('KN_BATH_SINK', 32, 2);
+put('BIN', 33, 2);
+put('KN_TOILET', 34, 2);
+put('KN_STALL', 35, 2);
+put('KN_TOILET', 36, 2);
+put('KN_BATHTUB', 31, 10);
+put('KN_TOWEL_RACK', 33, 10);
+put('KN_SHOWER', 36, 9);
+put('KN_PLANT', 35, 10);
+put('KN_AC', 24, 1); // Trabajo's wall, between the painting and the clock
+
+// ── Pasillo ──
+put('PLANT', 12, 13);
+put('PLANT', 18, 13);
+put('KN_PAINTING_WIDE', 14, 11); // on the hallway's top wall, between its two doors
+put('PLANT_2', 12, 23);
+put('PLANT_2', 18, 23);
