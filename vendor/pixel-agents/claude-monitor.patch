+++ b/webview-ui/test/petColor.test.ts
@@ -0,0 +1,112 @@
+/** claude-monitor patch: pet color presets, tint, cache, layout carry-through, add-many. */
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+import { beforeAll, test } from 'vitest';
+
+import { decodePetPng } from '../../core/src/assets/pngDecoder.js';
+import { PET_COLOR_PRESETS } from '../src/constants.js';
+import { addPlacedPet, removePlacedPet } from '../src/office/editor/editorActions.js';
+import { OfficeState } from '../src/office/engine/officeState.js';
+import { getPetSprites, setPetTemplates } from '../src/office/sprites/petSpriteData.js';
+import type { OfficeLayout, SpriteData } from '../src/office/types.js';
+import { TileType } from '../src/office/types.js';
+
+const petsDir = new URL('../public/assets/pets/', import.meta.url);
+const ids = ['claudio', 'gitcat']; // same alphabetical order the server uses => petType 0/1
+
+beforeAll(() => {
+  setPetTemplates(
+    ids.map((id) => decodePetPng(fs.readFileSync(new URL(`${id}/pet.png`, petsDir)))),
+    ['Claudio', 'Gitcat'],
+  );
+});
+
+const CAT = 1;
+const light = (hex: string) => {
+  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
+  return (Math.max(r, g, b) + Math.min(r, g, b)) / 2;
+};
+const px = (s: SpriteData) => s.flat();
+const bodyAvg = (color?: string) => {
+  const f = getPetSprites(CAT, color)!.idleDown[0];
+  const v = px(f).filter((p) => p !== '');
+  return v.reduce((a, p) => a + light(p), 0) / v.length;
+};
+
+test('tint keeps transparent pixels and geometry', () => {
+  const o = getPetSprites(CAT)!.walkDown[0];
+  const t = getPetSprites(CAT, 'naranja')!.walkDown[0];
+  assert.equal(t.length, o.length);
+  o.forEach((row, y) => row.forEach((p, x) => assert.equal(t[y][x] === '', p === '')));
+});
+
+test('tint keeps whiskers and nose', () => {
+  const t = px(getPetSprites(CAT, 'naranja')!.idleDown[0]);
+  assert.ok(t.includes('#C2B1A9'), 'whiskers');
+  assert.ok(t.includes('#CA719F'), 'nose');
+  assert.ok(!t.includes('#3E3636'), 'body recolored');
+});
+
+test('lightness ordering: chocolate < gris < crema < blanco, blanco lighter than negro', () => {
+  const l = (c?: string) => bodyAvg(c);
+  assert.ok(l('chocolate') < l('gris'));
+  assert.ok(l('gris') < l('crema'));
+  assert.ok(l('crema') < l('blanco'));
+  assert.ok(l('blanco') > l());
+});
+
+test('absent or unknown color = original object; same key = same cached object', () => {
+  assert.equal(getPetSprites(CAT, 'nope'), getPetSprites(CAT));
+  assert.equal(getPetSprites(CAT, undefined), getPetSprites(CAT));
+  assert.equal(getPetSprites(CAT, 'gris'), getPetSprites(CAT, 'gris'));
+  assert.notEqual(getPetSprites(CAT, 'gris'), getPetSprites(CAT, 'blanco'));
+  assert.equal(getPetSprites(CAT, 'negro'), getPetSprites(CAT)); // negro = original
+});
+
+test('presets exist per species and dog variants differ from the original', () => {
+  assert.deepEqual(
+    PET_COLOR_PRESETS.gitcat.map((p) => p.id),
+    ['negro', 'naranja', 'gris', 'blanco', 'chocolate', 'crema'],
+  );
+  assert.deepEqual(
+    PET_COLOR_PRESETS.claudio.map((p) => p.id),
+    ['canela', 'marron', 'blanco', 'negro'],
+  );
+  for (const id of ['marron', 'blanco', 'negro'])
+    assert.notDeepEqual(getPetSprites(0, id)!.idleDown[0], getPetSprites(0)!.idleDown[0]);
+});
+
+function layout(): OfficeLayout {
+  return {
+    version: 1,
+    cols: 6,
+    rows: 6,
+    tiles: Array(36).fill(TileType.FLOOR_1),
+    furniture: [],
+  } as unknown as OfficeLayout;
+}
+
+test('layout round-trip and syncLayoutPets keep color; adding a species twice yields two pets', () => {
+  let l = addPlacedPet(layout(), 'a', CAT, 'naranja');
+  l = addPlacedPet(l, 'b', CAT, 'gris');
+  l = addPlacedPet(l, 'c', 0);
+  const rt = JSON.parse(JSON.stringify(l)) as OfficeLayout;
+  assert.deepEqual(rt.pets, [
+    { id: 'a', petType: CAT, color: 'naranja' },
+    { id: 'b', petType: CAT, color: 'gris' },
+    { id: 'c', petType: 0 },
+  ]);
+  const os = new OfficeState(rt);
+  assert.equal(os.getPets().length, 3);
+  assert.equal(os.getPets().filter((p) => p.petType === CAT).length, 2);
+  assert.deepEqual(os.getLayout().pets, rt.pets); // syncLayoutPets kept color
+  os.addPet({ id: 'd', petType: CAT, color: 'crema' });
+  assert.equal(os.getLayout().pets!.at(-1)!.color, 'crema');
+});
+
+test('removePlacedPet removes one by id; unknown id returns same layout', () => {
+  const l = addPlacedPet(addPlacedPet(layout(), 'a', CAT), 'b', CAT);
+  assert.deepEqual(removePlacedPet(l, 'a').pets!.map((p) => p.id), ['b']);
+  assert.equal(removePlacedPet(l, 'zz'), l);
+});
