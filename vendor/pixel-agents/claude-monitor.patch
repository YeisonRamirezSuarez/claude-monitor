@@ -0,0 +1,77 @@
+/**
+ * claude-monitor patch: "Personalizar" (src/office/sprites/looks.ts) on the
+ * real character sheets.
+ */
+import assert from 'node:assert/strict';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { PNG } from 'pngjs';
+import { test } from 'vitest';
+
+import { cleanLook, colorRoles, dressFrame, type Look, type View } from '../src/office/sprites/looks.js';
+
+const DIR = path.join(__dirname, '..', 'public', 'assets', 'characters');
+
+function frame(base: number, row: number, f: number): string[][] {
+  const s = PNG.sync.read(fs.readFileSync(path.join(DIR, `char_${base}.png`)));
+  return Array.from({ length: 32 }, (_, y) =>
+    Array.from({ length: 16 }, (_, x) => {
+      const i = ((row * 32 + y) * s.width + f * 16 + x) * 4;
+      if (!s.data[i + 3]) return '';
+      return '#' + [0, 1, 2].map((k) => s.data[i + k].toString(16).padStart(2, '0')).join('').toUpperCase();
+    }),
+  );
+}
+const dress = (look: Look, view: View = 'down', f = 1) =>
+  dressFrame(frame(look.base, { down: 0, up: 1, right: 2 }[view], f), look, view, f, frame(look.base, 0, 1));
+const colors = (s: string[][]) => new Set(s.flat().filter(Boolean).map((p) => p.slice(0, 7).toLowerCase()));
+
+test('an untouched look draws the body as it is', () => {
+  assert.deepEqual(dress({ base: 4 }), frame(4, 0, 1));
+});
+
+test('colors are swapped: a green shirt, a new skin', () => {
+  const s = dress({ base: 4, top: '#22c55e', skin: '#8d5524' });
+  const shirt = s[21].slice(5, 11).map((p) => p.toLowerCase());
+  assert.ok(shirt.some((p) => /^#[0-4][0-9a-f][b-f]/.test(p) || p.startsWith('#2')), `shirt ${shirt}`);
+  assert.notDeepEqual(s, frame(4, 0, 1));
+});
+
+test('a new hairstyle replaces the head: the old hair colors are gone from it', () => {
+  for (const base of [0, 2, 4]) {
+    const roles = colorRoles(frame(base, 0, 1));
+    const old = [...roles].filter(([, r]) => r === 'hair').map(([c]) => c);
+    const head = colors(dress({ base, hairStyle: 'corto', hair: '#e8c060' }).slice(0, 17));
+    for (const c of old) assert.ok(!head.has(c), `base ${base}: old hair color ${c} still there`);
+    assert.ok(head.has('#e8c060'), 'the new hair');
+  }
+});
+
+test('every view and frame dresses without breaking, and the head sits on the collar', () => {
+  for (const view of ['down', 'up', 'right'] as View[])
+    for (let f = 0; f < 7; f++) {
+      const s = dress({ base: 1, hairStyle: 'afro', hat: 'gorra', glasses: 'redondas', beard: 'corta', outfit: 'vestido' }, view, f);
+      assert.equal(s.length, 32);
+      assert.equal(s[0].length, 16);
+      assert.ok(s.slice(0, 18).some((r) => r.some(Boolean)), `${view} ${f} has a head`);
+    }
+});
+
+test('build: tall adds two rows, short takes two, wide adds two columns to the body', () => {
+  assert.equal(dress({ base: 0, build: 'alto' }).length, 34);
+  assert.equal(dress({ base: 0, build: 'bajito' }).length, 30);
+  const wide = dress({ base: 0, build: 'grueso' });
+  assert.equal(wide[25].length, 18);
+  assert.equal(wide[5].length, 18);
+});
+
+test('a look from outside only keeps known values', () => {
+  assert.equal(cleanLook({ base: 9 }), null);
+  assert.equal(cleanLook('x'), null);
+  assert.deepEqual(cleanLook({ base: 2, hair: '#abcdef', hat: 'corona', skin: 'red', build: 'alto' }), {
+    base: 2,
+    hair: '#abcdef',
+    build: 'alto',
+  });
+});
