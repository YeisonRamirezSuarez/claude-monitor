diff --git a/webview-ui/test/claudeMonitor.test.ts b/webview-ui/test/claudeMonitor.test.ts
new file mode 100644
index 0000000..4e4d147
--- /dev/null
+++ b/webview-ui/test/claudeMonitor.test.ts
@@ -0,0 +1,168 @@
+/**
+ * claude-monitor patch: errands (library, sofa, talking), walking in/out
+ * through the door, and the per-account filter. Runs the real OfficeState on
+ * an all-floor layout and simulates time in small steps, like the game loop.
+ *
+ * Run with: npm test
+ */
+
+import assert from 'node:assert/strict';
+
+import { test } from 'vitest';
+
+import { OfficeState } from '../src/office/engine/officeState.js';
+import type { OfficeLayout } from '../src/office/types.js';
+import { Direction, TileType } from '../src/office/types.js';
+
+function floorLayout(cols = 12, rows = 10): OfficeLayout {
+  return { version: 1, cols, rows, tiles: new Array<TileType>(cols * rows).fill(TileType.FLOOR_1), furniture: [] };
+}
+
+function run(os: OfficeState, seconds: number): void {
+  for (let t = 0; t < seconds; t += 0.05) os.update(0.05);
+}
+
+/** An office past its warm-up, with one agent sitting at a desk seat. */
+function office() {
+  const os = new OfficeState(floorLayout());
+  os.seats.set('desk', { uid: 'desk', seatCol: 2, seatRow: 2, facingDir: Direction.UP, assigned: false });
+  run(os, 6); // warm-up: restored agents appear in place, only new ones walk in
+  os.addAgent(1, 0, 0, 'desk');
+  const ch = os.characters.get(1)!;
+  ch.matrixEffect = null;
+  return { os, ch };
+}
+
+test('a new session walks in from the door (bottom row) to its desk', () => {
+  const { os, ch } = office();
+  os.cm.arrive(1);
+  assert.equal(ch.tileRow, 9, 'starts on the bottom row: the door');
+  run(os, 10);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [2, 2], 'ends at its desk');
+});
+
+test('closing a session walks it out through the door before it fades', () => {
+  const { os, ch } = office();
+  os.removeAgent(1);
+  assert.equal(os.cm.isLeaving(ch), true);
+  assert.equal(ch.matrixEffect, null, 'does not vanish on the spot');
+  run(os, 12);
+  assert.equal(os.characters.has(1), false, 'gone after reaching the door');
+});
+
+test('thinking for a while sends it to the bookshelf; a tool brings it back', () => {
+  const { os, ch } = office();
+  os.layout.furniture.push({ uid: 'shelf', type: 'BOOKSHELF', col: 8, row: 0 });
+  os.setAgentActive(1, true);
+  run(os, 12);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [8, 1], 'standing right below the shelf');
+  assert.equal(ch.cmPose, 'stand');
+  os.cm.toolStart(1, 't1', 'Bash', false);
+  run(os, 10);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [2, 2], 'back at its desk');
+  assert.equal(ch.cmPose, undefined);
+});
+
+test('with nothing going on it rests on the sofa, not in the library', () => {
+  const { os, ch } = office();
+  os.layout.furniture.push({ uid: 'shelf', type: 'BOOKSHELF', col: 8, row: 0 });
+  os.layout.furniture.push({ uid: 'sofa', type: 'SOFA_FRONT', col: 9, row: 6 });
+  os.seats.set('sofa', { uid: 'sofa', seatCol: 9, seatRow: 6, facingDir: Direction.DOWN, assigned: false });
+  os.setAgentActive(1, false); // turn over
+  run(os, 12);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [9, 6], 'on the sofa');
+  assert.equal(ch.cmPose, 'sit');
+  run(os, 60);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [9, 6], 'stays there instead of wandering off');
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 't', 'Edit', false);
+  run(os, 12);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [2, 2], 'back to the desk when work starts');
+});
+
+test('still "active" but quiet for long is idle: sofa, not library', () => {
+  const { os, ch } = office();
+  os.layout.furniture.push({ uid: 'shelf', type: 'BOOKSHELF', col: 8, row: 0 });
+  os.layout.furniture.push({ uid: 'sofa', type: 'SOFA_FRONT', col: 9, row: 6 });
+  os.seats.set('sofa', { uid: 'sofa', seatCol: 9, seatRow: 6, facingDir: Direction.DOWN, assigned: false });
+  os.setAgentActive(1, true);
+  run(os, 12);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [8, 1], 'right after work: thinking at the shelf');
+  run(os, 50);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [9, 6], 'much later: resting on the sofa');
+});
+
+test('a lead waiting on its sub-agent stays at its desk; its seat persists', () => {
+  const { os, ch } = office();
+  os.layout.furniture.push({ uid: 'sofa', type: 'SOFA_FRONT', col: 9, row: 6 });
+  os.seats.set('sofa', { uid: 'sofa', seatCol: 9, seatRow: 6, facingDir: Direction.DOWN, assigned: false });
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'fg', 'Agent', false);
+  run(os, 60);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [2, 2], 'directing from its desk, not on the sofa');
+  assert.equal(os.getPersistableSeats()[1].seatId, 'desk');
+});
+
+test('a lead talking to its sub-agent walks next to it and both get a speech bubble', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false); // busy, so it does not wander off to think
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  Object.assign(sub, { tileCol: 8, tileRow: 5, x: 8 * 16 + 8, y: 5 * 16 + 8 });
+  os.cm.toolStart(subId, 's', 'Read', false);
+  os.cm.talk(1, subId);
+  run(os, 4);
+  const d = Math.abs(ch.tileCol - sub.tileCol) + Math.abs(ch.tileRow - sub.tileRow);
+  assert.ok(d <= 2, `next to the sub-agent (distance ${d})`);
+  assert.equal(ch.bubbleType, 'talk');
+  assert.equal(sub.bubbleType, 'talk');
+  run(os, 12);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [2, 2], 'back at its desk after the talk');
+  assert.equal(ch.bubbleType, null);
+});
+
+test('a new sub-agent takes the free desk closest to its lead', () => {
+  const { os } = office();
+  os.seats.set('near', { uid: 'near', seatCol: 4, seatRow: 2, facingDir: Direction.UP, assigned: false });
+  os.seats.set('far', { uid: 'far', seatCol: 11, seatRow: 9, facingDir: Direction.UP, assigned: false });
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  assert.equal(sub.seatId, 'near');
+  sub.matrixEffect = null;
+  run(os, 8);
+  assert.deepEqual([sub.tileCol, sub.tileRow], [4, 2], 'sitting next to its lead');
+  os.removeSubagent(1, 'toolu_1');
+  assert.equal(os.seats.get('near')!.assigned, false, 'the desk is free again once it leaves');
+});
+
+test('with a meeting room, both talkers go sit at the meeting table', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  os.layout.furniture.push({ uid: 'm1', type: 'WOODEN_CHAIR_SIDE', col: 8, row: 7 });
+  os.layout.furniture.push({ uid: 'm2', type: 'WOODEN_CHAIR_SIDE:left', col: 10, row: 7 });
+  os.seats.set('m1', { uid: 'm1', seatCol: 8, seatRow: 7, facingDir: Direction.RIGHT, assigned: false });
+  os.seats.set('m2', { uid: 'm2', seatCol: 10, seatRow: 7, facingDir: Direction.LEFT, assigned: false });
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Read', false);
+  os.cm.talk(subId, 1);
+  run(os, 8);
+  const seats = [[ch.tileCol, ch.tileRow], [sub.tileCol, sub.tileRow]].map((p) => p.join(',')).sort();
+  assert.deepEqual(seats, ['10,7', '8,7'], 'both at the meeting chairs');
+  assert.equal(ch.bubbleType, 'talk');
+  run(os, 15);
+  assert.deepEqual([ch.tileCol, ch.tileRow], [2, 2], 'lead back at its desk after the meeting');
+});
+
+test('the account filter hides a session and its sub-agents from drawing and clicks', () => {
+  const { os } = office();
+  const subId = os.addSubagent(1, 'toolu_1');
+  os.cm.setVisible([99]);
+  assert.equal(os.getCharacters().some((c) => c.id === 1 || c.id === subId), false);
+  os.cm.setVisible(null);
+  assert.equal(os.getCharacters().some((c) => c.id === 1), true);
+});
diff --git a/webview-ui/test/claudeMonitorEdificio.test.ts b/webview-ui/test/claudeMonitorEdificio.test.ts
new file mode 100644
index 0000000..8777a4e
--- /dev/null
+++ b/webview-ui/test/claudeMonitorEdificio.test.ts
@@ -0,0 +1,159 @@
+/**
+ * claude-monitor patch: the real "edificio" layout with the real furniture
+ * catalog (manifests from public/assets; sprites faked — seats, desks and
+ * footprints are all this needs). Checks each behavior ends in its room.
+ *
+ * Run with: npm test
+ */
+
+import assert from 'node:assert/strict';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { beforeAll, test } from 'vitest';
+
+import { OfficeState } from '../src/office/engine/officeState.js';
+import { buildDynamicCatalog } from '../src/office/layout/furnitureCatalog.js';
+import type { OfficeLayout } from '../src/office/types.js';
+
+const ASSETS = path.join(__dirname, '..', 'public', 'assets');
+
+type Asset = Record<string, unknown> & { id: string };
+
+function loadCatalog(): void {
+  const catalog: Asset[] = [];
+  const walk = (m: Record<string, unknown>, group: Record<string, unknown>) => {
+    if (m.type === 'asset') {
+      catalog.push({
+        ...m,
+        id: m.id as string,
+        label: m.id,
+        category: group.category,
+        isDesk: group.category === 'desks',
+        canPlaceOnWalls: group.canPlaceOnWalls,
+        canPlaceOnSurfaces: group.canPlaceOnSurfaces,
+        backgroundTiles: m.backgroundTiles ?? group.backgroundTiles,
+      } as Asset);
+    } else for (const x of (m.members as Record<string, unknown>[]) ?? []) walk(x, group);
+  };
+  for (const dir of fs.readdirSync(path.join(ASSETS, 'furniture'))) {
+    const manifest = JSON.parse(fs.readFileSync(path.join(ASSETS, 'furniture', dir, 'manifest.json'), 'utf8'));
+    walk(manifest, manifest);
+  }
+  const sprites = Object.fromEntries(catalog.map((a) => [a.id, [['#000']]]));
+  assert.ok(buildDynamicCatalog({ catalog, sprites } as never), 'catalog built');
+}
+
+function edificio(): OfficeLayout {
+  return JSON.parse(fs.readFileSync(path.join(ASSETS, 'default-layout-2.json'), 'utf8'));
+}
+
+const area = (os: OfficeState, col: number, row: number) =>
+  os.layout.areaTiles?.[row * os.layout.cols + col] ?? null;
+
+function run(os: OfficeState, seconds: number): void {
+  for (let t = 0; t < seconds; t += 0.05) os.update(0.05);
+}
+
+beforeAll(loadCatalog);
+
+function office() {
+  const os = new OfficeState(edificio());
+  run(os, 6);
+  os.addAgent(1, 0, 0);
+  const ch = os.characters.get(1)!;
+  ch.matrixEffect = null;
+  return { os, ch };
+}
+
+test('the building has desks, sofas, shelves and meeting chairs', () => {
+  const os = new OfficeState(edificio());
+  const areas = [...os.seats.values()].map((s) => area(os, s.seatCol, s.seatRow));
+  const count = (a: string) => areas.filter((x) => x === a).length;
+  assert.ok(count('Trabajo') >= 8, `desks in Trabajo: ${count('Trabajo')}`);
+  assert.ok(count('Despacho') >= 2, `desks in Despacho: ${count('Despacho')}`);
+  assert.ok(count('Descanso') >= 8, `sofa seats in Descanso: ${count('Descanso')}`);
+  assert.ok(count('Reuniones') >= 8, `meeting chairs: ${count('Reuniones')}`);
+});
+
+test('an agent with nothing to do rests on a sofa in Descanso', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, false);
+  run(os, 40);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Descanso', `at ${ch.tileCol},${ch.tileRow}`);
+  assert.equal(ch.cmPose, 'sit');
+});
+
+test('when claude-monitor says it waits for you, it rests even if the office thinks it is busy', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'stuck', 'Bash', false); // a tool-done that never arrived
+  run(os, 10);
+  assert.notEqual(area(os, ch.tileCol, ch.tileRow), 'Descanso', 'on its own it stays working');
+  for (let t = 0; t < 30; t += 0.05) {
+    if (Math.round(t * 20) % 30 === 0) os.cm.setExternalState(1, 'esperando');
+    os.update(0.05);
+  }
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Descanso', `at ${ch.tileCol},${ch.tileRow}`);
+});
+
+test('an agent thinking right after a tool reads in the Biblioteca', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  run(os, 30);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Biblioteca', `at ${ch.tileCol},${ch.tileRow}`);
+});
+
+test('leads sit in the Despacho and their sub-agents work in Trabajo', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Edit', false);
+  run(os, 25);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Despacho', `lead at ${ch.tileCol},${ch.tileRow}`);
+  assert.equal(area(os, sub.tileCol, sub.tileRow), 'Trabajo', `sub at ${sub.tileCol},${sub.tileRow}`);
+});
+
+test('a finished sub-agent reports to its lead in Reuniones, then walks out', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Edit', false);
+  run(os, 20);
+  os.removeSubagent(1, 'toolu_1');
+  run(os, 14);
+  assert.equal(area(os, sub.tileCol, sub.tileRow), 'Reuniones', `reporting at ${sub.tileCol},${sub.tileRow}`);
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Reuniones', 'its lead is there too');
+  run(os, 40);
+  assert.equal(os.characters.has(subId), false, 'then it walked out the door');
+  assert.equal(area(os, ch.tileCol, ch.tileRow), 'Despacho', 'and the lead went back to its desk');
+});
+
+test('a lead and its sub-agent talking meet in Reuniones', () => {
+  const { os, ch } = office();
+  os.setAgentActive(1, true);
+  os.cm.toolStart(1, 'x', 'Bash', false);
+  const subId = os.addSubagent(1, 'toolu_1');
+  const sub = os.characters.get(subId)!;
+  sub.matrixEffect = null;
+  os.cm.toolStart(subId, 's', 'Read', false);
+  run(os, 3);
+  os.cm.talk(subId, 1);
+  // Seats are assigned at random, so the walk varies: they must meet within
+  // the walk allowance (20 s), wherever each one started.
+  let met = false;
+  for (let t = 0; t < 22 && !met; t += 0.05) {
+    os.update(0.05);
+    met =
+      area(os, ch.tileCol, ch.tileRow) === 'Reuniones' &&
+      area(os, sub.tileCol, sub.tileRow) === 'Reuniones' &&
+      ch.bubbleType === 'talk';
+  }
+  assert.ok(met, `met in Reuniones (lead ${ch.tileCol},${ch.tileRow} · sub ${sub.tileCol},${sub.tileRow})`);
+});
