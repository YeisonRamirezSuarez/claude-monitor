diff --git a/server/__tests__/claudeMonitorHooks.test.ts b/server/__tests__/claudeMonitorHooks.test.ts
new file mode 100644
index 0000000..570683e
--- /dev/null
+++ b/server/__tests__/claudeMonitorHooks.test.ts
@@ -0,0 +1,68 @@
+/**
+ * claude-monitor patch: the Claude provider installs, checks and removes the
+ * hooks in every claude-monitor account (profiles.json), skipping WSL ones and
+ * accounts whose config dir does not exist.
+ */
+
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+
+let tmpBase: string;
+
+vi.mock('os', async () => {
+  const actual = await vi.importActual<typeof import('os')>('os');
+  return { ...actual, homedir: () => tmpBase };
+});
+
+const { claudeProvider } = await import('../src/providers/hook/claude/claude.js');
+
+let savedAppData: string | undefined;
+const settings = (dir: string) => path.join(dir, 'settings.json');
+const hasOurHook = (dir: string) =>
+  fs.existsSync(settings(dir)) && fs.readFileSync(settings(dir), 'utf8').includes('claude-hook.js');
+
+beforeEach(() => {
+  tmpBase = fs.mkdtempSync(path.join(os.tmpdir(), 'pxl-cm-hooks-'));
+  savedAppData = process.env.APPDATA;
+  process.env.APPDATA = path.join(tmpBase, 'appdata');
+});
+
+afterEach(() => {
+  process.env.APPDATA = savedAppData;
+  fs.rmSync(tmpBase, { recursive: true, force: true });
+});
+
+it('installs in every account, skipping WSL and missing dirs, and uninstalls from all', async () => {
+  const main = path.join(tmpBase, '.claude');
+  const other = path.join(tmpBase, 'profiles', 'b');
+  const wsl = path.join(tmpBase, 'profiles', 'wsl');
+  const missing = path.join(tmpBase, 'profiles', 'missing');
+  for (const d of [main, other, wsl]) fs.mkdirSync(d, { recursive: true });
+  fs.writeFileSync(settings(other), JSON.stringify({ permissions: { allow: ['Read'] } }));
+  fs.mkdirSync(path.join(tmpBase, 'appdata', 'claude-monitor'), { recursive: true });
+  fs.writeFileSync(
+    path.join(tmpBase, 'appdata', 'claude-monitor', 'profiles.json'),
+    JSON.stringify({
+      profiles: [
+        { id: 'b', configDir: other },
+        { id: 'w', configDir: wsl, entorno: { tipo: 'wsl' } },
+        { id: 'm', configDir: missing },
+      ],
+    }),
+  );
+
+  await claudeProvider.installHooks('http://127.0.0.1:1', 't');
+  expect(hasOurHook(main)).toBe(true);
+  expect(hasOurHook(other)).toBe(true);
+  expect(JSON.parse(fs.readFileSync(settings(other), 'utf8')).permissions.allow).toEqual(['Read']);
+  expect(fs.existsSync(settings(wsl))).toBe(false);
+  expect(fs.existsSync(missing)).toBe(false);
+  expect(await claudeProvider.areHooksInstalled()).toBe(true);
+
+  await claudeProvider.uninstallHooks();
+  expect(hasOurHook(main)).toBe(false);
+  expect(hasOurHook(other)).toBe(false);
+  expect(await claudeProvider.areHooksInstalled()).toBe(false);
+});
