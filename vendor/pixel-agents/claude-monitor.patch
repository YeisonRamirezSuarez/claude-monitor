+/** A workflow agent whose transcript has been silent this long is gone even
+ *  without a result (the run was stopped). */
+const STALE_MS = 15 * 60_000;
+
+interface Journal {
+  offset: number;
+  rest: string;
+  started: Set<string>;
+  done: Set<string>;
+}
+const journals = new Map<string, Journal>();
+/** "leadId:spawnId" of the workflow agents currently shown. */
+const shown = new Set<string>();
+
+export const workflowSpawnId = (runId: string, agentId: string) => `wf:${runId}:${agentId}`;
+
+/** Read only what was appended since last time: results make journals big. */
+function readJournal(file: string): Journal {
+  let j = journals.get(file);
+  if (!j) {
+    j = { offset: 0, rest: '', started: new Set(), done: new Set() };
+    journals.set(file, j);
+  }
+  let size = 0;
+  try {
+    size = fs.statSync(file).size;
+  } catch {
+    return j;
+  }
+  if (size < j.offset) {
+    j.offset = 0;
+    j.rest = '';
+    j.started.clear();
+    j.done.clear();
+  }
+  if (size === j.offset) return j;
+  const fd = fs.openSync(file, 'r');
+  try {
+    const buf = Buffer.alloc(size - j.offset);
+    fs.readSync(fd, buf, 0, buf.length, j.offset);
