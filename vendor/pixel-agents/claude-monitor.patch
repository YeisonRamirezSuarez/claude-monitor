diff --git a/webview-ui/src/claudeMonitorBridge.ts b/webview-ui/src/claudeMonitorBridge.ts
new file mode 100644
index 0000000..5bbb944
--- /dev/null
+++ b/webview-ui/src/claudeMonitorBridge.ts
@@ -0,0 +1,110 @@
+// Local patch (claude-monitor): messages from the claude-monitor window that
+// embeds this office in an iframe. It knows things the office does not —
+// which account each session belongs to, and which sub-agent a SendMessage was
+// addressed to — and tells the engine.
+import type { OfficeState } from './office/engine/officeState.js';
+import { cleanLook, type Look } from './office/sprites/looks.js';
+
+/** Tell claude-monitor to keep a look: for this session, for its whole
+ *  account, or drop it (look null). It answers with `claude-monitor:looks`. */
+export function saveLook(agentId: number, look: Look | null, scope: 'sesion' | 'cuenta'): void {
+  if (window.parent !== window) window.parent.postMessage({ type: 'claude-monitor:apariencia', agentId, look, scope }, '*');
+}
+
+type Incoming =
+  /** Main agent ids to show (the account filter); null shows everyone. */
+  | { type: 'claude-monitor:visible'; ids: number[] | null }
+  /** A lead and one of its sub-agents talked. `toSub`: the lead wrote. */
+  | { type: 'claude-monitor:talk'; agentId: number; parentToolId: string; toSub: boolean }
+  /** claude-monitor saw this session's process end: close it (walks out). The
+   *  office only learns on its own through a SessionEnd hook, which accounts
+   *  without the hooks installed never send. */
+  | { type: 'claude-monitor:close'; id: number }
+  /** Focus (zoom in + follow) the lead, or its sub-agent when parentToolId is given. */
+  | { type: 'claude-monitor:focus'; agentId: number; parentToolId?: string | null }
+  | { type: 'claude-monitor:unfocus' }
+  /** The sub-agents claude-monitor sees still running for a lead (their spawn
+   *  ids). The office drops the ones that stay missing: a finished spawn whose
+   *  completion event never reached it stayed in the office forever. */
+  | { type: 'claude-monitor:subs'; agentId: number; alive: string[] }
+  /** What each agent is doing, as claude-monitor reads it (lead: parentToolId null). */
+  | {
+      type: 'claude-monitor:estados';
+      items: Array<{ agentId: number; parentToolId?: string | null; estado: string }>;
+    }
+  /** What each sub-agent is doing (its task), keyed like the sub-character. */
+  | { type: 'claude-monitor:labels'; items: Array<{ agentId: number; parentToolId: string; label: string }> }
+  /** How each lead is dressed (its session's look, or its account's); null: its own palette. */
+  | { type: 'claude-monitor:looks'; items: Array<{ agentId: number; look: unknown }> }
+  /** Open the "Personalizar" panel for this lead. */
+  | { type: 'claude-monitor:customize'; agentId: number };
+
+/** Consecutive reports a sub-agent must be missing from before it is let go
+ *  (claude-monitor reports every ~1.5 s; a just-launched spawn may not have
+ *  its sidecar yet). */
+const MISSES_TO_DROP = 4;
+const misses = new Map<string, number>();
+
+export function installClaudeMonitorBridge(
+  getOfficeState: () => OfficeState,
+  closeAgent: (id: number) => void,
+): void {
+  if (window.parent === window) return;
+  window.addEventListener('message', (e: MessageEvent) => {
+    if (e.source !== window.parent) return;
+    const msg = e.data as Incoming;
+    const os = getOfficeState();
+    if (msg?.type === 'claude-monitor:visible') {
+      os.cm.setVisible(Array.isArray(msg.ids) ? msg.ids.filter((n) => typeof n === 'number') : null);
+    } else if (msg?.type === 'claude-monitor:focus' && typeof msg.agentId === 'number') {
+      const id = msg.parentToolId ? os.getSubagentId(msg.agentId, String(msg.parentToolId)) : msg.agentId;
+      if (id !== null && os.selectedAgentId !== id) {
+        window.dispatchEvent(new CustomEvent('claude-monitor-focus', { detail: { id } }));
+      }
+    } else if (msg?.type === 'claude-monitor:unfocus') {
+      if (os.cameraFollowId !== null) window.dispatchEvent(new CustomEvent('claude-monitor-focus', { detail: { id: null } }));
+    } else if (msg?.type === 'claude-monitor:subs' && typeof msg.agentId === 'number' && Array.isArray(msg.alive)) {
+      const alive = new Set(msg.alive.map(String));
+      for (const meta of [...os.subagentMeta.values()]) {
+        if (meta.parentAgentId !== msg.agentId) continue;
+        const key = `${meta.parentAgentId}:${meta.parentToolId}`;
+        if (alive.has(meta.parentToolId)) {
+          misses.delete(key);
+          continue;
+        }
+        const n = (misses.get(key) ?? 0) + 1;
+        misses.set(key, n);
+        if (n >= MISSES_TO_DROP) {
+          misses.delete(key);
+          os.removeSubagent(meta.parentAgentId, meta.parentToolId); // reports, then walks out
+        }
+      }
+    } else if (msg?.type === 'claude-monitor:estados' && Array.isArray(msg.items)) {
+      for (const it of msg.items) {
+        if (typeof it?.agentId !== 'number' || typeof it.estado !== 'string') continue;
+        const id = it.parentToolId ? os.getSubagentId(it.agentId, String(it.parentToolId)) : it.agentId;
+        if (id !== null) os.cm.setExternalState(id, it.estado);
+      }
+    } else if (msg?.type === 'claude-monitor:close' && typeof msg.id === 'number') {
+      if (os.characters.has(msg.id)) closeAgent(msg.id);
+    } else if (msg?.type === 'claude-monitor:labels' && Array.isArray(msg.items)) {
+      for (const it of msg.items) {
+        if (typeof it?.agentId === 'number' && typeof it.label === 'string') {
+          os.cm.setSubagentLabel(it.agentId, String(it.parentToolId), it.label);
+        }
+      }
+    } else if (msg?.type === 'claude-monitor:looks' && Array.isArray(msg.items)) {
+      for (const it of msg.items) {
+        const ch = typeof it?.agentId === 'number' ? os.characters.get(it.agentId) : undefined;
+        if (ch) ch.cmLook = cleanLook(it.look) ?? undefined;
+      }
+    } else if (msg?.type === 'claude-monitor:customize' && typeof msg.agentId === 'number') {
+      window.dispatchEvent(new CustomEvent('claude-monitor-customize', { detail: { id: msg.agentId } }));
+    } else if (msg?.type === 'claude-monitor:talk' && typeof msg.agentId === 'number') {
+      const sub = os.getSubagentId(msg.agentId, String(msg.parentToolId));
+      if (sub === null) return;
+      if (msg.toSub) os.cm.talk(msg.agentId, sub);
+      else os.cm.talk(sub, msg.agentId);
+    }
+  });
+}
