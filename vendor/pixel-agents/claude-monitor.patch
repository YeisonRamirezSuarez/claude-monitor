+/**
+ * claude-monitor patch: topmost furniture on a tile, for the Erase tool.
+ * Surface items (on a desk) win over the desk under them, and an item whose
+ * tile is in another item's background rows wins over that item; ties go to
+ * the later one in the array. Same footprint test as the SELECT hit-test.
+ */
+export function furnitureAt(
+  layout: OfficeLayout,
+  col: number,
+  row: number,
+): PlacedFurniture | null {
+  let hit: PlacedFurniture | null = null;
+  let hitRank = -1;
+  for (const f of layout.furniture) {
+    const entry = getCatalogEntry(f.type);
+    if (!entry) continue;
+    if (col < f.col || col >= f.col + entry.footprintW) continue;
+    if (row < f.row || row >= f.row + entry.footprintH) continue;
+    const rank = entry.canPlaceOnSurfaces ? 2 : row - f.row >= (entry.backgroundTiles || 0) ? 1 : 0;
+    if (rank >= hitRank) {
+      hit = f;
+      hitRank = rank;
+    }
+  }
+  return hit;
+}
