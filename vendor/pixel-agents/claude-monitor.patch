+      if (!c.leaveAfterTalk) this.placeByRole(ch, c);
+
+      // A finished sub-agent reports to its lead, then walks out.
+      if (c.leaveAfterTalk && c.errand !== 'talk' && !(c.talkUntil > this.clock)) {
+        c.leaveAfterTalk = false;
+        this.leave(ch);
+        continue;
+      }
+
+      const running = [...c.pending.values()];
+      const waitingOnSub = running.some((t) => SUBAGENT_TOOLS.has(t.name) && !t.background);
+      // A lead waiting on its sub-agent is not idle: it is directing.
+      c.idleSec = ch.isActive && running.length === 0 ? c.idleSec + dt : 0;
+      if (waitingOnSub && !ch.isSubagent) c.idleSec = 0;
+      const talking = c.talkUntil > this.clock && c.talkWith !== null && this.os.characters.has(c.talkWith);
+
+      const ext = this.externalState(ch.id);
+      const guessed: Errand | null =
+        ch.isActive && waitingOnSub && ch.isSubagent
+          ? 'wait'
+          : !ch.isActive || c.idleSec > IDLE_AFTER_SEC
+            ? 'rest'
+            : c.idleSec > THINK_AFTER_SEC
+              ? 'think'
+              : null;
+      // claude-monitor's word wins when it has one (see the header).
+      const fromMonitor: Errand | null | undefined =
+        ext === 'esperando' || ext === 'terminado'
+          ? 'rest'
+          : ext === 'pensando'
+            ? c.idleSec > THINK_AFTER_SEC || !ch.isActive
+              ? 'think'
+              : null
+            : ext === 'escribiendo' || ext === 'leyendo' || ext === 'permiso'
+              ? null
+              : ext === 'delegando'
+                ? ch.isSubagent
+                  ? 'wait'
+                  : null
+                : undefined;
+      const want: Errand | null = talking ? 'talk' : fromMonitor !== undefined ? fromMonitor : guessed;
+      if (want !== c.errand) {
+        this.endErrand(ch, c);
+        if (want) this.startErrand(ch, c, want);
+      }
