diff --git a/scripts/claude-monitor-kenney.cjs b/scripts/claude-monitor-kenney.cjs
new file mode 100644
index 0000000..5b36762
--- /dev/null
+++ b/scripts/claude-monitor-kenney.cjs
@@ -0,0 +1,259 @@
+// Local patch (claude-monitor): imports furniture from Kenney's "Roguelike
+// Indoors" pack (CC0 1.0 — https://kenney.nl/assets/roguelike-indoors) into
+// webview-ui/public/assets/furniture/KN_*/, one folder + manifest per item,
+// so the "edificio" layout can have what the stock set lacks: meeting tables,
+// a kitchen, armchairs, a piano, floor lamps, wall art. Kenney's pack has no
+// screens, so KN_TV / KN_PROJ_SCREEN / KN_PROJECTOR / KN_TV_STAND are drawn
+// here pixel by pixel, in the style of the stock whiteboard and PC.
+//
+//   node scripts/claude-monitor-kenney.cjs <path to roguelikeIndoor_transparent.png>
+//
+// The sheet is a grid of 16×16 tiles with a 1 px margin.
+const fs = require('fs');
+const path = require('path');
+const { PNG } = require('pngjs');
+
+const sheetPath = process.argv[2];
+if (!sheetPath) throw new Error('usage: node scripts/claude-monitor-kenney.cjs <roguelikeIndoor_transparent.png>');
+const sheet = PNG.sync.read(fs.readFileSync(sheetPath));
+const OUT = path.join(__dirname, '..', 'webview-ui', 'public', 'assets', 'furniture');
+
+function crop(c, r, w, h) {
+  const out = new PNG({ width: w * 16, height: h * 16 });
+  for (let tr = 0; tr < h; tr++)
+    for (let tc = 0; tc < w; tc++)
+      for (let y = 0; y < 16; y++)
+        for (let x = 0; x < 16; x++) {
+          const si = (((r + tr) * 17 + y) * sheet.width + (c + tc) * 17 + x) * 4;
+          const di = ((tr * 16 + y) * out.width + tc * 16 + x) * 4;
+          for (let k = 0; k < 4; k++) out.data[di + k] = sheet.data[si + k];
+        }
+  return out;
+}
+
+const base = (id, name, category, w, h, extra = {}) => ({
+  id,
+  name,
+  category,
+  type: 'asset',
+  file: `${id}.png`,
+  width: w * 16,
+  height: h * 16,
+  footprintW: w,
+  footprintH: h,
+  canPlaceOnWalls: false,
+  canPlaceOnSurfaces: false,
+  backgroundTiles: 0,
+  ...extra,
+});
+
+// [id, name, category, sheet col, row, w, h, extra manifest fields]
+const ITEMS = [
+  ['KN_TABLE_LONG', 'Mesa larga (Kenney)', 'desks', 16, 8, 3, 1],
+  ['KN_TABLE_OVAL', 'Mesa ovalada (Kenney)', 'desks', 19, 8, 2, 1],
+  ['KN_TABLE_ROUND', 'Mesa redonda (Kenney)', 'desks', 7, 0, 1, 1],
+  ['KN_SOFA_ARMCHAIR', 'Sillón (Kenney)', 'chairs', 14, 9, 1, 1],
+  ['KN_COUNTER', 'Mueble de cocina (Kenney)', 'misc', 0, 12, 1, 1],
+  ['KN_SINK', 'Fregadero (Kenney)', 'misc', 8, 12, 1, 1],
+  ['KN_STOVE', 'Cocina (Kenney)', 'misc', 14, 14, 2, 2],
+  ['KN_FRIDGE', 'Nevera (Kenney)', 'misc', 11, 15, 1, 2, { backgroundTiles: 1 }],
+  ['KN_PIANO', 'Piano (Kenney)', 'decor', 23, 8, 2, 2, { backgroundTiles: 1 }],
+  ['KN_PLANT', 'Planta (Kenney)', 'decor', 16, 0, 1, 1],
+  ['KN_LAMP', 'Lámpara de pie (Kenney)', 'decor', 19, 3, 1, 3, { backgroundTiles: 2 }],
+  ['KN_ARMCHAIR_GREEN', 'Sillón verde (Kenney)', 'chairs', 14, 11, 1, 1],
+  ['KN_CANDELABRA', 'Candelabro (Kenney)', 'decor', 20, 1, 1, 1, { canPlaceOnSurfaces: true }],
+  ['KN_LAMP_GOLD', 'Lámpara dorada (Kenney)', 'decor', 20, 3, 1, 3, { backgroundTiles: 2 }],
+  ['KN_PLANT_SMALL', 'Planta pequeña (Kenney)', 'decor', 17, 0, 1, 1, { canPlaceOnSurfaces: true }],
+  ['KN_PAINTING_WIDE', 'Cuadro panorámico (Kenney)', 'wall', 16, 14, 3, 1, { canPlaceOnWalls: true }],
+  ['KN_MAP', 'Mapamundi (Kenney)', 'wall', 20, 14, 2, 1, { canPlaceOnWalls: true }],
+  ['KN_PORTRAIT', 'Retrato (Kenney)', 'wall', 19, 15, 1, 2, { canPlaceOnWalls: true }],
+  ['KN_MIRROR', 'Espejo (Kenney)', 'wall', 22, 16, 1, 2, { canPlaceOnWalls: true }],
+  ['KN_SHELF', 'Estante con tazas (Kenney)', 'storage', 20, 17, 1, 1],
+  ['KN_DRAWERS', 'Cómoda (Kenney)', 'storage', 1, 17, 1, 1],
+];
+
+for (const [id, name, category, c, r, w, h, extra] of ITEMS) {
+  const dir = path.join(OUT, id);
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, `${id}.png`), PNG.sync.write(crop(c, r, w, h)));
+  fs.writeFileSync(path.join(dir, 'manifest.json'), JSON.stringify(base(id, name, category, w, h, extra), null, 2) + '\n');
+}
+
+// A rotation group of one chair model: front / back / side (side mirrored).
+function chairGroup(id, name, c, r) {
+  const dir = path.join(OUT, id);
+  fs.mkdirSync(dir, { recursive: true });
+  const members = [
+    [`${id}_FRONT`, c, 'front'],
+    [`${id}_BACK`, c + 1, 'back'],
+    [`${id}_SIDE`, c + 2, 'side'],
+  ].map(([mid, mc, orientation]) => {
+    fs.writeFileSync(path.join(dir, `${mid}.png`), PNG.sync.write(crop(mc, r, 1, 1)));
+    return {
+      type: 'asset',
+      id: mid,
+      file: `${mid}.png`,
+      width: 16,
+      height: 16,
+      footprintW: 1,
+      footprintH: 1,
+      orientation,
+      ...(orientation === 'side' ? { mirrorSide: true } : {}),
+    };
+  });
+  fs.writeFileSync(
+    path.join(dir, 'manifest.json'),
+    JSON.stringify(
+      {
+        id,
+        name,
+        category: 'chairs',
+        type: 'group',
+        groupType: 'rotation',
+        rotationScheme: '3-way-mirror',
+        canPlaceOnWalls: false,
+        canPlaceOnSurfaces: false,
+        backgroundTiles: 0,
+        members,
+      },
+      null,
+      2,
+    ) + '\n',
+  );
+}
+// Meeting chairs. The ids must keep matching /KN_CHAIR/ (claudeMonitor.ts MEETING).
+chairGroup('KN_CHAIR', 'Silla de reunión (Kenney)', 0, 2);
+chairGroup('KN_CHAIR_GRAY', 'Silla gris (Kenney)', 0, 8);
+chairGroup('KN_CHAIR_TALL', 'Silla de respaldo alto (Kenney)', 0, 7);
+
+// ── Drawn here: Kenney's pack has no screens ────────────────────────────
+// Same pixel-art idea as the stock WHITEBOARD (32×32, content on y 8..23) and
+// PC: 1 px dark outline, flat fills, one highlight.
+const rgb = (h) => [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
+function px(img, x, y, color) {
+  if (x < 0 || y < 0 || x >= img.width || y >= img.height) return;
+  const i = (y * img.width + x) * 4;
+  img.data.set([...rgb(color), 255], i);
+}
+function rect(img, x0, y0, x1, y1, color) {
+  for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) px(img, x, y, color);
+}
+function line(img, x0, y0, x1, y1, color) {
+  const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0));
+  for (let i = 0; i <= n; i++) px(img, Math.round(x0 + ((x1 - x0) * i) / n), Math.round(y0 + ((y1 - y0) * i) / n), color);
+}
+/** Draw rows of characters; '.' is transparent, others are looked up in `legend`. */
+function art(img, x0, y0, rows, legend) {
+  for (const row of rows) if (row.length !== img.width - x0) throw new Error(`art row is ${row.length} wide: ${row}`);
+  rows.forEach((row, dy) => [...row].forEach((ch, dx) => ch !== '.' && px(img, x0 + dx, y0 + dy, legend[ch])));
+}
+
+const TV = { outline: '1c1f22', bezel: '2b2f33', screen: '1e3a5f', glare: '2f5a8a', glare2: '264a75', led: '5fbf7a' };
+/** A flat TV: dark bezel, blue screen crossed by two diagonal glare bands. */
+function tv(img, x0, y0, w, h) {
+  rect(img, x0, y0, x0 + w - 1, y0 + h - 1, TV.outline);
+  rect(img, x0 + 1, y0 + 1, x0 + w - 2, y0 + h - 2, TV.bezel);
+  const sx = x0 + 2;
+  const sy = y0 + 2;
+  const sw = w - 4;
+  const sh = h - 5; // the bottom bezel is one row thicker (where the LED sits)
+  for (let y = 0; y < sh; y++) {
+    for (let x = 0; x < sw; x++) {
+      const u = x + y; // '/' diagonals
+      const band = u >= sh + 2 && u <= sh + 4 ? TV.glare : u >= sh + 7 && u <= sh + 8 ? TV.glare2 : TV.screen;
+      px(img, sx + x, sy + y, band);
+    }
+  }
+  px(img, x0 + w - 5, y0 + h - 2, TV.led);
+}
+
+const drawn = {};
+// KN_TV — 2×2 wall TV, same box as the whiteboard (x 2..29, y 8..23).
+{
+  const img = new PNG({ width: 32, height: 32 });
+  tv(img, 2, 8, 28, 16);
+  drawn.KN_TV = [img, 'Televisor', 'electronics', 2, 2, { canPlaceOnWalls: true }];
+}
+// KN_PROJ_SCREEN — 3×2 tripod projection screen: roller case, white panel, weighted hem, legs.
+{
+  const img = new PNG({ width: 48, height: 32 });
+  const D = '4a4e4d';
+  rect(img, 3, 2, 44, 5, D); // roller case
+  rect(img, 4, 3, 43, 4, '6b7072');
+  rect(img, 4, 3, 43, 3, '8a8f91');
+  rect(img, 2, 3, 2, 4, D);
+  rect(img, 45, 3, 45, 4, D);
+  rect(img, 5, 6, 42, 25, D); // panel frame
+  rect(img, 6, 6, 41, 23, 'efebe8');
+  rect(img, 6, 6, 41, 6, 'b9bcbd'); // shadow under the case
+  rect(img, 6, 7, 8, 23, 'e9ecee'); // light on the left
+  rect(img, 40, 7, 41, 23, 'd6d7d8'); // shade on the right
+  rect(img, 6, 21, 39, 23, 'd6d7d8'); // hem
+  rect(img, 6, 24, 41, 24, 'b9bcbd');
+  rect(img, 22, 26, 25, 28, D); // pole
+  px(img, 23, 26, 'b9bcbd');
+  px(img, 23, 27, 'b9bcbd');
+  line(img, 23, 28, 13, 31, D); // tripod
+  line(img, 24, 28, 34, 31, D);
+  rect(img, 22, 29, 25, 31, D);
+  drawn.KN_PROJ_SCREEN = [img, 'Pantalla de proyección', 'wall', 3, 2, { canPlaceOnWalls: true }];
+}
+// KN_PROJECTOR — 1×1 tabletop projector, seen from the front.
+{
+  const img = new PNG({ width: 16, height: 16 });
+  const body = (inner) => `.o${inner}o.`; // inner is 12 px wide
+  art(
+    img,
+    0,
+    3,
+    [
+      '..oooooooooooo..',
+      body('tttttttttttt'), // top face
+      body('tsstsstssttt'), // vents
+      body('hhhhhhhhhhhh'), // front edge
+      body('ffoooffffffs'), // lens (ring, glass, glint) and controls
+      body('fohggofdfrfs'),
+      body('foglgofffffs'),
+      body('fogggofsssss'),
+      body('ffoooffffffs'),
+      '..oooooooooooo..',
+      '..oo........oo..',
+    ],
+    { o: '3f3740', t: 'e1e3e9', s: '757b7c', h: 'ffffff', f: 'b5bfc7', g: '5b8fc7', l: '2b3a4f', d: '4ade80', r: 'e0524d' },
+  );
+  drawn.KN_PROJECTOR = [img, 'Proyector', 'electronics', 1, 1, { canPlaceOnSurfaces: true }];
+}
+// KN_TV_STAND — 2×2 TV on a low wooden cabinet (top row is background: walk behind the TV).
+{
+  const img = new PNG({ width: 32, height: 32 });
+  tv(img, 5, 1, 22, 13);
+  rect(img, 13, 14, 18, 14, TV.bezel); // neck
+  rect(img, 9, 15, 22, 15, TV.outline); // foot
+  const W = { dk: '8f673f', md: 'b98b5e', lt: 'c8a480', hi: 'e6dabf' };
+  rect(img, 2, 16, 29, 29, W.dk);
+  rect(img, 3, 17, 28, 18, W.lt); // top
+  rect(img, 3, 20, 28, 28, W.md); // front
+  rect(img, 15, 20, 16, 28, W.dk); // door gap
+  for (const x0 of [4, 18]) {
+    rect(img, x0, 21, x0 + 9, 27, W.lt);
+    rect(img, x0 + 1, 22, x0 + 8, 26, W.md);
+  }
+  px(img, 13, 24, W.hi);
+  px(img, 18, 24, W.hi);
+  rect(img, 3, 30, 5, 31, W.dk); // legs
+  rect(img, 26, 30, 28, 31, W.dk);
+  drawn.KN_TV_STAND = [img, 'Mueble de TV', 'misc', 2, 2, { backgroundTiles: 1 }];
+}
+for (const [id, [img, name, category, w, h, extra]] of Object.entries(drawn)) {
+  const dir = path.join(OUT, id);
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, `${id}.png`), PNG.sync.write(img));
+  fs.writeFileSync(path.join(dir, 'manifest.json'), JSON.stringify(base(id, name, category, w, h, extra), null, 2) + '\n');
+}
+
+fs.writeFileSync(
+  path.join(OUT, '..', 'KENNEY-LICENSE.txt'),
+  'KN_* furniture: "Roguelike Indoors" by Kenney (www.kenney.nl), CC0 1.0 Universal.\n' +
+    'https://kenney.nl/assets/roguelike-indoors — free to use, credit appreciated.\n',
+);
+console.log(`${ITEMS.length + 3} Kenney + ${Object.keys(drawn).length} drawn items written to ${OUT}`);
diff --git a/scripts/claude-monitor-layout.mjs b/scripts/claude-monitor-layout.mjs
new file mode 100644
index 0000000..2678ab3
--- /dev/null
+++ b/scripts/claude-monitor-layout.mjs
@@ -0,0 +1,207 @@
+// Local patch (claude-monitor): generates the "edificio" office layout — one
+// building with themed rooms around a central hallway whose door is at the
+// bottom: Despacho (leads), Trabajo (sub-agents), Biblioteca (thinking),
+// Descanso (kitchen + sofas: resting), Reuniones (where agents that talk meet).
+// Furniture: the stock set plus the KN_* items imported from Kenney's CC0
+// "Roguelike Indoors" (scripts/claude-monitor-kenney.cjs). Rugs are the
+// engine's own carpet layer (walkable, colorized).
+//
+//   node scripts/claude-monitor-layout.mjs > webview-ui/public/assets/default-layout-3.json
+//
+// It is the bundled default (revision 3 > the stock 1): a fresh install gets
+// it, and a layout.json still on the stock office is replaced by it.
+//
+// Wall-mounted furniture sits on the wall row (its bottom tile on the wall),
+// the same way the bundled default layout does it.
+
+const W = 31;
+const H = 27;
+const VOID = 255;
+const WALL = 0;
+const WOOD = 7; // floor pattern ids from assets/floors
+const TILE = 1;
+const MARBLE = 9;
+
+const COLORS = {
+  wall: { h: 214, s: 30, b: -100, c: -55 },
+  despacho: { h: 22, s: 45, b: -58, c: -80 },
+  trabajo: { h: 210, s: 8, b: -30, c: -70 },
+  hall: { h: 215, s: 6, b: -45, c: -20 },
+  biblioteca: { h: 28, s: 45, b: -40, c: -85 },
+  descanso: { h: 32, s: 50, b: -28, c: -85 },
+  reuniones: { h: 30, s: 42, b: -33, c: -85 },
+};
+const rug = (h, s, b) => ({ h, s, b, c: 0, colorize: true });
+const RUGS = {
+  navy: { variant: 0, color: rug(222, 45, -35), accentColor: rug(40, 70, 15) },
+  teal: { variant: 1, color: rug(190, 40, -30), accentColor: rug(45, 60, 20) },
+  wine: { variant: 2, color: rug(350, 45, -35), accentColor: rug(40, 65, 15) },
+  hall: { variant: 0, color: rug(220, 15, -50), accentColor: rug(215, 10, -25) },
+};
+
+const tiles = new Array(W * H).fill(VOID);
+const tileColors = new Array(W * H).fill(null);
+const areaTiles = new Array(W * H).fill(null);
+const carpetTiles = new Array(W * H).fill(null);
+const at = (c, r) => r * W + c;
+
+function fill(c0, r0, c1, r1, type, color, area = null) {
+  for (let r = r0; r <= r1; r++) {
+    for (let c = c0; c <= c1; c++) {
+      tiles[at(c, r)] = type;
+      tileColors[at(c, r)] = type === WALL ? COLORS.wall : color;
+      areaTiles[at(c, r)] = type === WALL ? null : area;
+    }
+  }
+}
+const wall = (c0, r0, c1, r1) => fill(c0, r0, c1, r1, WALL, null);
+const door = (c, r, color, area = null) => fill(c, r, c, r, MARBLE, color, area);
+function carpet(c0, r0, c1, r1, style) {
+  for (let r = r0; r <= r1; r++) for (let c = c0; c <= c1; c++) carpetTiles[at(c, r)] = { ...style };
+}
+
+// Shell
+wall(0, 1, W - 1, H - 1);
+// Rooms (interiors)
+fill(1, 2, 14, 10, WOOD, COLORS.despacho, 'Despacho');
+fill(16, 2, 29, 10, TILE, COLORS.trabajo, 'Trabajo');
+fill(12, 12, 18, 25, MARBLE, COLORS.hall, 'Pasillo');
+fill(1, 12, 10, 17, WOOD, COLORS.biblioteca, 'Biblioteca');
+fill(1, 19, 10, 25, WOOD, COLORS.descanso, 'Descanso');
+fill(20, 12, 29, 25, WOOD, COLORS.reuniones, 'Reuniones');
+// Doors between rooms and the hallway, and the entrance at the bottom
+door(13, 11, COLORS.hall, 'Pasillo');
+door(17, 11, COLORS.hall, 'Pasillo');
+door(11, 15, COLORS.hall, 'Pasillo');
+door(11, 22, COLORS.hall, 'Pasillo');
+door(19, 18, COLORS.hall, 'Pasillo');
+door(15, H - 1, COLORS.hall, 'Pasillo');
+
+// Rugs
+carpet(2, 3, 12, 9, RUGS.navy); // under the leads' desks
+carpet(2, 14, 9, 16, RUGS.teal); // reading corner
+carpet(2, 21, 9, 24, RUGS.wine); // lounge
+carpet(21, 13, 28, 24, RUGS.navy); // meeting room
+carpet(14, 13, 16, 25, RUGS.hall); // hallway runner to the door
+
+let n = 0;
+const furniture = [];
+const put = (type, col, row) => furniture.push({ uid: `cm-edificio-${++n}`, type, col, row });
+
+// ── Despacho: where the leads (main agents) sit — two rows of three ──
+put('DOUBLE_BOOKSHELF', 1, 0);
+put('LARGE_PAINTING', 6, 0);
+put('CLOCK', 10, 0);
+put('KN_TV', 3, 0);
+put('KN_MIRROR', 5, 0);
+put('KN_MAP', 8, 1);
+put('KN_PORTRAIT', 11, 0);
+put('HANGING_PLANT', 13, 0);
+for (const row of [3, 7]) {
+  for (const col of [2, 6, 10]) {
+    put('DESK_FRONT', col, row);
+    put('PC_FRONT_OFF', col + 1, row);
+    put('COFFEE', col + 2, row + 1);
+    put('CUSHIONED_CHAIR_BACK', col + 1, row + 2);
+  }
+}
+put('KN_LAMP', 1, 3);
+put('KN_PLANT', 14, 2);
+put('KN_PLANT', 1, 9);
+put('KN_PLANT', 14, 9);
+
+// ── Trabajo: where the sub-agents work — two rows of four desks ──
+put('WHITEBOARD', 17, 0);
