@@ -251,3 +251,39 @@ export function adjustSprite(sprite: SpriteData, color: ColorValue): SpriteData
 
   return result;
 }
+
+// claude-monitor patch: per-pet color presets.
+/** Target look for a pet: pixels with lightness in `src` are re-hued to (h, s) and remapped onto lo..hi. */
+export interface PetTint {
+  h: number;
+  s: number;
+  lo: number;
+  hi: number;
+  /** Source lightness range of the body tones being recolored. */
+  src: [number, number];
+}
+
+/**
+ * Recolor a pet sprite's body tones. Hue rotation can't work on near-gray fur, so body pixels
+ * (lightness within `src`, +/- a small margin) are remapped to a fixed hue/sat with a lightness
+ * ramp; everything else (whiskers, nose, eyes, transparent pixels) is left untouched.
+ */
+export function tintPetSprite(sprite: SpriteData, tint: PetTint): SpriteData {
+  const [a, b] = tint.src;
+  return sprite.map((row) =>
+    row.map((pixel) => {
+      if (pixel === '') return '';
+      const [, , l] = rgbToHsl(
+        parseInt(pixel.slice(1, 3), 16),
+        parseInt(pixel.slice(3, 5), 16),
+        parseInt(pixel.slice(5, 7), 16),
+      );
+      if (l < a - 0.03 || l > b + 0.05) return pixel;
+      const t = Math.max(0, Math.min(1, (l - a) / (b - a)));
+      return appendAlpha(
+        hslToHex(tint.h, tint.s, tint.lo + t * (tint.hi - tint.lo)),
+        extractAlpha(pixel),
+      );
+    }),
+  );
+}
