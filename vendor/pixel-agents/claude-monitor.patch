diff --git a/server/src/claudeMonitorNames.ts b/server/src/claudeMonitorNames.ts
new file mode 100644
index 0000000..c97ab97
--- /dev/null
+++ b/server/src/claudeMonitorNames.ts
@@ -0,0 +1,60 @@
+// Local patch (claude-monitor): the label each character shows.
+//
+// 1. The name the user set in claude-monitor (`nombres.json`: sessionId ->
+//    { nombre, nota }), read on every lookup so a rename shows up the next
+//    time the webview asks for the agent list.
+// 2. Otherwise the session's own name from Claude Code's live-session registry
+//    (`<configDir>/sessions/<pid>.json`, e.g. "vendigmachine-fa"): several
+//    sessions in the same folder would otherwise all read "VendigMachine".
+import * as fs from 'fs';
+import * as path from 'path';
+
+const MONITOR_DIR = path.join(process.env.APPDATA || '', 'claude-monitor');
+const NAMES_FILE = path.join(MONITOR_DIR, 'nombres.json');
+const REGISTRY_TTL_MS = 10_000;
+
+let registry: { at: number; names: Map<string, string> } | null = null;
+
+function sessionRegistryNames(): Map<string, string> {
+  if (registry && Date.now() - registry.at < REGISTRY_TTL_MS) return registry.names;
+  const names = new Map<string, string>();
+  const dirs = [path.join(process.env.USERPROFILE || '', '.claude')];
+  try {
+    const profiles = JSON.parse(fs.readFileSync(path.join(MONITOR_DIR, 'profiles.json'), 'utf8')).profiles || [];
+    for (const p of profiles) if (typeof p.configDir === 'string') dirs.push(p.configDir);
+  } catch {
+    /* no claude-monitor */
+  }
+  for (const dir of dirs) {
+    let files: string[] = [];
+    try {
+      files = fs.readdirSync(path.join(dir, 'sessions')).filter((f) => /^\d+\.json$/.test(f));
+    } catch {
+      continue;
+    }
+    for (const f of files) {
+      try {
+        const s = JSON.parse(fs.readFileSync(path.join(dir, 'sessions', f), 'utf8'));
+        if (typeof s.sessionId === 'string' && typeof s.name === 'string' && s.name.trim()) {
+          names.set(s.sessionId, s.name.trim());
+        }
+      } catch {
+        /* half-written or foreign file */
+      }
+    }
+  }
+  registry = { at: Date.now(), names };
+  return names;
+}
+
+export function claudeMonitorName(sessionId: string | undefined): string | undefined {
+  if (!sessionId) return undefined;
+  try {
+    const all = JSON.parse(fs.readFileSync(NAMES_FILE, 'utf8')) as Record<string, { nombre?: unknown }>;
+    const nombre = all[sessionId]?.nombre;
+    if (typeof nombre === 'string' && nombre.trim()) return nombre.trim();
+  } catch {
+    /* no names yet */
+  }
+  return sessionRegistryNames().get(sessionId);
+}
diff --git a/server/src/claudeMonitorWorkflows.ts b/server/src/claudeMonitorWorkflows.ts
new file mode 100644
index 0000000..c38d83b
--- /dev/null
+++ b/server/src/claudeMonitorWorkflows.ts
@@ -0,0 +1,131 @@
+// Local patch (claude-monitor): agents of a Workflow run (multi-agent
+// orchestration: code-review, audits…) as sub-agents of the session that
+// launched it.
+//
+// They are not Agent-tool spawns: no tool_use id, no sidecar toolUseId. Their
+// transcripts live one level deeper, under
+//   <projectDir>/<sessionId>/subagents/workflows/<runId>/agent-<id>.jsonl
+// with a `.meta.json` (description = the agent's label, workflowPhase) and a
+// `journal.jsonl` for the whole run: `started` / `result` per agentId. So an
+// agent is running from its `started` until its `result`.
+//
+// Running ones are watched through the same shadow-store SubagentWatch the
+// stock code uses for background spawns, keyed by a synthetic spawn id
+// `wf:<runId>:<agentId>` — the webview then creates and animates the
+// sub-character from the translated subagentToolStart messages. When the
+// result lands (or the transcript goes quiet for long), a subagentClear walks
+// it out.
+import * as fs from 'fs';
+import * as path from 'path';
+
+import type { AgentStateStore } from './agentStateStore.js';
+import type { SubagentWatch } from './subagentWatch.js';
+import type { AgentState } from './types.js';
+
+/** A workflow agent whose transcript has been silent this long is gone even
+ *  without a result (the run was stopped). */
+const STALE_MS = 15 * 60_000;
+
+interface Journal {
+  offset: number;
+  rest: string;
+  started: Set<string>;
+  done: Set<string>;
+}
+const journals = new Map<string, Journal>();
+/** "leadId:spawnId" of the workflow agents currently shown. */
+const shown = new Set<string>();
+
+export const workflowSpawnId = (runId: string, agentId: string) => `wf:${runId}:${agentId}`;
+
+/** Read only what was appended since last time: results make journals big. */
+function readJournal(file: string): Journal {
+  let j = journals.get(file);
+  if (!j) {
+    j = { offset: 0, rest: '', started: new Set(), done: new Set() };
+    journals.set(file, j);
+  }
+  let size = 0;
+  try {
+    size = fs.statSync(file).size;
+  } catch {
+    return j;
+  }
+  if (size < j.offset) {
+    j.offset = 0;
+    j.rest = '';
+    j.started.clear();
+    j.done.clear();
+  }
+  if (size === j.offset) return j;
+  const fd = fs.openSync(file, 'r');
+  try {
+    const buf = Buffer.alloc(size - j.offset);
+    fs.readSync(fd, buf, 0, buf.length, j.offset);
+    j.offset = size;
+    const lines = (j.rest + buf.toString('utf8')).split('\n');
+    j.rest = lines.pop() ?? '';
+    for (const line of lines) {
+      // Cheap filter first: result lines carry whole reports.
+      if (!line.includes('"type":"started"') && !line.includes('"type":"result"')) continue;
+      try {
+        const e = JSON.parse(line) as { type?: string; agentId?: string };
+        if (typeof e.agentId !== 'string') continue;
+        if (e.type === 'started') j.started.add(e.agentId);
+        if (e.type === 'result') j.done.add(e.agentId);
+      } catch {
+        /* partial line */
+      }
+    }
+  } finally {
+    fs.closeSync(fd);
+  }
+  return j;
+}
+
+function recent(file: string): boolean {
+  try {
+    return Date.now() - fs.statSync(file).mtimeMs < STALE_MS;
+  } catch {
+    return false;
+  }
+}
+
+/** Show the lead's running workflow agents; clear the ones that finished. */
+export function scanWorkflowAgents(
+  leadId: number,
+  lead: AgentState,
+  agents: AgentStateStore,
+  subagentWatch: SubagentWatch | null,
+): void {
+  if (!subagentWatch || !lead.projectDir || !lead.sessionId) return;
+  const root = path.join(lead.projectDir, lead.sessionId, 'subagents', 'workflows');
+  let runs: string[] = [];
+  try {
+    runs = fs.readdirSync(root);
+  } catch {
+    runs = [];
+  }
+  const alive = new Set<string>();
+  for (const runId of runs) {
+    const dir = path.join(root, runId);
+    const journal = readJournal(path.join(dir, 'journal.jsonl'));
+    for (const agentId of journal.started) {
+      if (journal.done.has(agentId)) continue;
+      const jsonlPath = path.join(dir, `agent-${agentId}.jsonl`);
+      if (!recent(jsonlPath)) continue;
+      const spawnId = workflowSpawnId(runId, agentId);
+      alive.add(spawnId);
+      if (shown.has(`${leadId}:${spawnId}`) || subagentWatch.isWatching(jsonlPath)) continue;
+      shown.add(`${leadId}:${spawnId}`);
+      subagentWatch.watch(lead, leadId, { jsonlPath, toolUseId: spawnId });
+    }
+  }
+  for (const key of [...shown]) {
+    const [id, spawnId] = [Number(key.slice(0, key.indexOf(':'))), key.slice(key.indexOf(':') + 1)];
+    if (id !== leadId || alive.has(spawnId)) continue;
+    shown.delete(key);
+    subagentWatch.removeBySpawn(leadId, spawnId);
+    agents.broadcast({ type: 'subagentClear', id: leadId, parentToolId: spawnId });
+  }
+}
