+// Resolve the deepest existing ancestor to its real path so both spellings
+// collapse to one key; the file itself may not exist yet.
+const realDirs = new Map<string, string>();
+function realAncestor(p: string): string {
+  let dir = path.dirname(p);
+  const rest = [path.basename(p)];
+  while (dir !== path.dirname(dir)) {
+    const cached = realDirs.get(dir);
+    if (cached) return path.join(cached, ...[...rest].reverse());
+    try {
+      const real = fs.realpathSync.native(dir);
+      realDirs.set(dir, real);
+      return path.join(real, ...[...rest].reverse());
+    } catch {
+      rest.push(path.basename(dir));
+      dir = path.dirname(dir);
+    }
+  }
+  return p;
+}
