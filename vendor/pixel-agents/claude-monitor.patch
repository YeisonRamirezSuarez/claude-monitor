+  agents: AgentStateStore,
+  subagentWatch: SubagentWatch | null,
+): void {
+  if (!subagentWatch || !lead.projectDir || !lead.sessionId) return;
+  const root = path.join(lead.projectDir, lead.sessionId, 'subagents', 'workflows');
+  let runs: string[] = [];
+  try {
+    runs = fs.readdirSync(root);
+  } catch {
+    runs = [];
+  }
+  const alive = new Set<string>();
+  for (const runId of runs) {
+    const dir = path.join(root, runId);
+    const journal = readJournal(path.join(dir, 'journal.jsonl'));
+    for (const agentId of journal.started) {
+      if (journal.done.has(agentId)) continue;
+      const jsonlPath = path.join(dir, `agent-${agentId}.jsonl`);
+      if (!recent(jsonlPath)) continue;
+      const spawnId = workflowSpawnId(runId, agentId);
+      alive.add(spawnId);
+      if (shown.has(`${leadId}:${spawnId}`) || subagentWatch.isWatching(jsonlPath)) continue;
+      shown.add(`${leadId}:${spawnId}`);
+      subagentWatch.watch(lead, leadId, { jsonlPath, toolUseId: spawnId });
+    }
+  }
+  for (const key of [...shown]) {
+    const [id, spawnId] = [Number(key.slice(0, key.indexOf(':'))), key.slice(key.indexOf(':') + 1)];
+    if (id !== leadId || alive.has(spawnId)) continue;
+    shown.delete(key);
+    subagentWatch.removeBySpawn(leadId, spawnId);
+    agents.broadcast({ type: 'subagentClear', id: leadId, parentToolId: spawnId });
+  }
+}
