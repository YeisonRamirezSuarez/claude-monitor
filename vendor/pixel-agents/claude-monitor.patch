+  const o = v as Record<string, unknown>;
+  const base = Number(o.base);
+  if (!Number.isInteger(base) || base < 0 || base > 5) return null;
+  const color = (k: string) => (typeof o[k] === 'string' && HEX.test(o[k] as string) ? (o[k] as string) : undefined);
+  const pick = <T extends string>(k: string, list: readonly T[]) => (list.includes(o[k] as T) ? (o[k] as T) : undefined);
