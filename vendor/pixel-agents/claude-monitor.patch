+export function tintPetSprite(sprite: SpriteData, tint: PetTint): SpriteData {
+  const [a, b] = tint.src;
+  return sprite.map((row) =>
+    row.map((pixel) => {
+      if (pixel === '') return '';
+      const [, , l] = rgbToHsl(
+        parseInt(pixel.slice(1, 3), 16),
+        parseInt(pixel.slice(3, 5), 16),
+        parseInt(pixel.slice(5, 7), 16),
+      );
+      if (l < a - 0.03 || l > b + 0.05) return pixel;
+      const t = Math.max(0, Math.min(1, (l - a) / (b - a)));
+      return appendAlpha(
+        hslToHex(tint.h, tint.s, tint.lo + t * (tint.hi - tint.lo)),
+        extractAlpha(pixel),
+      );
+    }),
+  );
+}
