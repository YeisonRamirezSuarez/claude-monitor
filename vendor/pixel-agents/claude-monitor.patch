+      ctx.fillRect(bx + 2 * zoom, by + 4 * zoom, 7 * zoom, zoom);
+      ctx.fillRect(bx + 2 * zoom, by + 6 * zoom, 4 * zoom, zoom);
+      continue;
+    }
+
     const sprite =
       ch.bubbleType === 'permission' ? BUBBLE_PERMISSION_SPRITE : BUBBLE_WAITING_SPRITE;
 
